     }
 
     private Value container(final Value.Kind kind, final Accumulator accumulator) {
-        return this.container(kind, accumulator.maxDepth);
+        return this.container(kind, accumulator.maxDepth, accumulator.nodes, accumulator.stringChars);
     }
 
     private Value container(final Value.Kind kind, final int childDepth) {
+        return this.container(kind, childDepth, 0, 0);
+    }
+
+    private Value container(final Value.Kind kind, final int childDepth, final long childNodes, final long stringChars) {
         final int depth = childDepth + 1;
         if (depth > this.maxDepth) {
             throw new DecoderException("NBT depth exceeded: " + depth + " > " + this.maxDepth);
         }
-        return new Value(kind, depth);
+        final Value value = new Value(kind, depth, Math.addExact(childNodes, 1), stringChars);
+        this.checkBudget(value);
+        return value;
+    }
+
+    private Value primitive(final long stringChars) {
+        final Value value = new Value(Value.Kind.PRIMITIVE, 0, 1, stringChars);
+        this.checkBudget(value);
+        return value;
+    }
+
+    private Value primitiveList(final long elements) {
+        final Value value = new Value(Value.Kind.PRIMITIVE, 0, Math.addExact(elements, 1), 0);
+        this.checkBudget(value);
+        return value;
+    }
+
+    private void checkBudget(final Accumulator accumulator) {
+        this.checkBudget(accumulator.nodes + 1, accumulator.stringChars);
+    }
+
+    private void checkBudget(final Value value) {
+        this.checkBudget(value.nodes, value.stringChars);
+    }
+
+    private void checkBudget(final long nodes, final long stringChars) {
+        if (nodes > this.maxNodes) {
+            throw new DecoderException("Encoded value node count exceeded: " + nodes + " > " + this.maxNodes);
+        }
+        if (stringChars > this.maxStringChars) {
+            throw new DecoderException("Encoded value string length exceeded: " + stringChars + " > " + this.maxStringChars);
+        }
     }
 
     private static final class Accumulator {
         private int maxDepth;
+        private long nodes;
+        private long stringChars;
 
         private void accept(final Value value) {
             this.acceptDepth(value.depth);
+            this.nodes = Math.addExact(this.nodes, value.nodes);
+            this.stringChars = Math.addExact(this.stringChars, value.stringChars);
         }
 
         private void acceptDepth(final int depth) {
             this.maxDepth = Math.max(this.maxDepth, depth);
         }
+
+        private void acceptContents(final Value value) {
+            this.acceptDepth(value.depth - 1);
+            this.nodes = Math.addExact(this.nodes, value.nodes - 1);
+            this.stringChars = Math.addExact(this.stringChars, value.stringChars);
+        }
     }
 
     public static final class Value {
-        private static final Value EMPTY = new Value(Kind.EMPTY, 0);
-        private static final Value PRIMITIVE = new Value(Kind.PRIMITIVE, 0);
+        private static final Value EMPTY = new Value(Kind.EMPTY, 0, 0, 0);
 
         private final Kind kind;
         private final int depth;
+        private final long nodes;
+        private final long stringChars;
 
-        private Value(final Kind kind, final int depth) {
+        private Value(final Kind kind, final int depth, final long nodes, final long stringChars) {
             this.kind = kind;
             this.depth = depth;
+            this.nodes = nodes;
+            this.stringChars = stringChars;
         }
 
         public int depth() {
             return this.depth;
         }
 
+        public long nodes() {
+            return this.nodes;
+        }
+
+        public long stringChars() {
+            return this.stringChars;
+        }
+
         private enum Kind {
             EMPTY,
             PRIMITIVE,
