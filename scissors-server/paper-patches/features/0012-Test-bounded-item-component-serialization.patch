diff --git a/src/test/java/io/papermc/paper/item/OversizedItemComponentTest.java b/src/test/java/io/papermc/paper/item/OversizedItemComponentTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2d1a57fc57024625035962bfe62615f117fad2b3
--- /dev/null
+++ b/src/test/java/io/papermc/paper/item/OversizedItemComponentTest.java
@@ -0,0 +1,155 @@
+package io.papermc.paper.item;
+
+import io.netty.buffer.Unpooled;
+import java.util.List;
+import java.util.stream.IntStream;
+import net.minecraft.advancements.predicates.DataComponentMatchers;
+import net.minecraft.advancements.predicates.ItemPredicate;
+import net.minecraft.core.component.DataComponentExactPredicate;
+import net.minecraft.core.component.DataComponentMap;
+import net.minecraft.core.component.DataComponentPatch;
+import net.minecraft.core.component.DataComponentType;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.IntArrayTag;
+import net.minecraft.nbt.NbtOps;
+import net.minecraft.nbt.Tag;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.resources.RegistryOps;
+import net.minecraft.world.LockCode;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.component.CustomModelData;
+import org.bukkit.support.RegistryHelper;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@AllFeatures
+class OversizedItemComponentTest {
+
+    private static final int EXPLOIT_LIST_SIZE = 9_000;
+
+    @Test
+    void stripsOversizedLockBeforePersistentComponentDecode() {
+        final RegistryOps<Tag> ops = RegistryHelper.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+        final CompoundTag components = componentsWithOversizedLock();
+        components.putInt("minecraft:damage", 1);
+
+        final DataComponentPatch decoded = DataComponentPatch.CODEC.parse(ops, components).getOrThrow();
+
+        assertNull(decoded.get(DataComponentMap.EMPTY, DataComponents.LOCK));
+        assertEquals(1, decoded.get(DataComponentMap.EMPTY, DataComponents.DAMAGE));
+    }
+
+    @Test
+    void appliesTheSameLimitToEveryPersistentComponentType() {
+        final RegistryOps<Tag> ops = RegistryHelper.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+        final CompoundTag customData = new CompoundTag();
+        customData.put("attacker_chosen_list", new IntArrayTag(IntStream.range(0, EXPLOIT_LIST_SIZE).toArray()));
+        final CompoundTag components = new CompoundTag();
+        components.put("minecraft:custom_data", customData);
+        components.putInt("minecraft:repair_cost", 7);
+
+        final DataComponentPatch decoded = DataComponentPatch.CODEC.parse(ops, components).getOrThrow();
+
+        assertNull(decoded.get(DataComponentMap.EMPTY, DataComponents.CUSTOM_DATA));
+        assertEquals(7, decoded.get(DataComponentMap.EMPTY, DataComponents.REPAIR_COST));
+    }
+
+    @Test
+    void stripsOversizedLockWhenLoadingAnItemAndKeepsValidRemainder() {
+        final RegistryOps<Tag> ops = RegistryHelper.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+        final CompoundTag item = new CompoundTag();
+        item.putString("id", "minecraft:stone");
+        item.putInt("count", 1);
+        final CompoundTag components = componentsWithOversizedLock();
+        components.putInt("minecraft:repair_cost", 7);
+        item.put("components", components);
+
+        final ItemStack decoded = ItemStack.CODEC.parse(ops, item).getOrThrow();
+
+        assertNull(decoded.get(DataComponents.LOCK));
+        assertEquals(7, decoded.get(DataComponents.REPAIR_COST));
+    }
+
+    @Test
+    void skipsOversizedDelimitedComponentBeforeItsNetworkCodecRuns() {
+        final RegistryFriendlyByteBuf input = new RegistryFriendlyByteBuf(Unpooled.buffer(), RegistryHelper.registryAccess());
+        input.writeVarInt(2);
+        input.writeVarInt(0);
+        writeDelimited(input, DataComponents.LOCK, oversizedLock());
+        writeDelimited(input, DataComponents.REPAIR_COST, 7);
+
+        final DataComponentPatch decoded = DataComponentPatch.DELIMITED_STREAM_CODEC.decode(input);
+
+        assertNull(decoded.get(DataComponentMap.EMPTY, DataComponents.LOCK));
+        assertEquals(7, decoded.get(DataComponentMap.EMPTY, DataComponents.REPAIR_COST));
+        assertTrue(decoded.wasSanitizedDuringDecode());
+        assertEquals(0, input.readableBytes());
+    }
+
+    @Test
+    void stripsProgrammaticallyConstructedOversizedComponentsBeforePersistentEncode() {
+        final DataComponentPatch input = DataComponentPatch.builder()
+            .set(DataComponents.LOCK, oversizedLock())
+            .set(DataComponents.REPAIR_COST, 7)
+            .build();
+        final RegistryOps<Tag> ops = RegistryHelper.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+
+        final Tag encoded = DataComponentPatch.CODEC.encodeStart(ops, input).getOrThrow();
+        final DataComponentPatch decoded = DataComponentPatch.CODEC.parse(ops, encoded).getOrThrow();
+
+        assertNull(decoded.get(DataComponentMap.EMPTY, DataComponents.LOCK));
+        assertEquals(7, decoded.get(DataComponentMap.EMPTY, DataComponents.REPAIR_COST));
+    }
+
+    @Test
+    void keepsOrdinaryLockPredicates() {
+        final RegistryOps<Tag> ops = RegistryHelper.registryAccess().createSerializationContext(NbtOps.INSTANCE);
+        final DataComponentPatch input = DataComponentPatch.builder()
+            .set(DataComponents.LOCK, lockWithColors(List.of(0x123456, 0x654321)))
+            .build();
+        final Tag encoded = DataComponentPatch.CODEC.encodeStart(ops, input).getOrThrow();
+        final DataComponentPatch decoded = DataComponentPatch.CODEC.parse(ops, encoded).getOrThrow();
+
+        assertEquals(input.get(DataComponentMap.EMPTY, DataComponents.LOCK), decoded.get(DataComponentMap.EMPTY, DataComponents.LOCK));
+    }
+
+    private static CompoundTag componentsWithOversizedLock() {
+        final CompoundTag customModelData = new CompoundTag();
+        customModelData.put("colors", new IntArrayTag(IntStream.range(0, EXPLOIT_LIST_SIZE).toArray()));
+        final CompoundTag expectedComponents = new CompoundTag();
+        expectedComponents.put("minecraft:custom_model_data", customModelData);
+        final CompoundTag lock = new CompoundTag();
+        lock.put("components", expectedComponents);
+        final CompoundTag components = new CompoundTag();
+        components.put("minecraft:lock", lock);
+        return components;
+    }
+
+    private static LockCode oversizedLock() {
+        return lockWithColors(IntStream.range(0, EXPLOIT_LIST_SIZE).boxed().toList());
+    }
+
+    private static LockCode lockWithColors(final List<Integer> colors) {
+        final CustomModelData customModelData = new CustomModelData(List.of(), List.of(), List.of(), colors);
+        final DataComponentMatchers matchers = DataComponentMatchers.Builder.components()
+            .exact(DataComponentExactPredicate.expect(DataComponents.CUSTOM_MODEL_DATA, customModelData))
+            .build();
+        return new LockCode(ItemPredicate.Builder.item().withComponents(matchers).build());
+    }
+
+    private static <T> void writeDelimited(
+        final RegistryFriendlyByteBuf output, final DataComponentType<T> type, final T value
+    ) {
+        DataComponentType.STREAM_CODEC.encode(output, type);
+        final RegistryFriendlyByteBuf component = new RegistryFriendlyByteBuf(Unpooled.buffer(), output);
+        type.streamCodec().encode(component, value);
+        output.writeVarInt(component.readableBytes());
+        output.writeBytes(component);
+        component.release();
+    }
+}
