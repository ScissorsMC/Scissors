+package io.papermc.paper.scissors;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.level.entity.ChunkEntitySlices;
+import ca.spottedleaf.moonrise.patches.chunk_system.level.entity.EntityLookup;
+import ca.spottedleaf.moonrise.patches.collisions.CollisionUtil;
+import io.papermc.paper.configuration.WorldConfiguration;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import java.util.stream.Stream;
+import net.minecraft.server.level.FullChunkStatus;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.entity.vehicle.VehicleEntity;
+import net.minecraft.world.entity.vehicle.boat.Boat;
+import net.minecraft.world.entity.vehicle.boat.ChestBoat;
+import net.minecraft.world.entity.vehicle.minecart.Minecart;
+import net.minecraft.world.entity.vehicle.minecart.MinecartChest;
+import net.minecraft.world.entity.vehicle.minecart.MinecartCommandBlock;
+import net.minecraft.world.entity.vehicle.minecart.MinecartFurnace;
+import net.minecraft.world.entity.vehicle.minecart.MinecartHopper;
+import net.minecraft.world.entity.vehicle.minecart.MinecartSpawner;
+import net.minecraft.world.entity.vehicle.minecart.MinecartTNT;
+import net.minecraft.world.entity.vehicle.minecart.NewMinecartBehavior;
+import net.minecraft.world.entity.vehicle.minecart.OldMinecartBehavior;
+import net.minecraft.world.flag.FeatureFlags;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.AABB;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.spigotmc.SpigotWorldConfig;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyBoolean;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.anyList;
+import static org.mockito.Mockito.doCallRealMethod;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@Normal
+class VehicleCollisionLimitTest {
+
+    @Test
+    void limitsRepeatWarningsToEveryFiveMinutes() throws ReflectiveOperationException {
+        final var interval = VehicleEntity.class.getDeclaredField("COLLISION_OVERFLOW_WARNING_INTERVAL");
+        interval.setAccessible(true);
+        assertEquals(300_000L, interval.getLong(null));
+    }
+
+    @Test
+    void honorsSmallerConfiguredLimit() {
+        assertEquals(8, collisionLimit(8));
+        assertEquals(1, collisionLimit(1));
+        assertEquals(16, collisionLimit(16));
+        assertEquals(16, collisionLimit(17));
+    }
+
+    @Test
+    void handlesDisabledAndExcessiveConfiguration() {
+        assertEquals(0, collisionLimit(0));
+        assertEquals(0, collisionLimit(-1));
+        assertEquals(16, collisionLimit(1000));
+    }
+
+    @Test
+    void evaluatesPredicatesOnlyForBoundedRawCandidates() {
+        final AtomicInteger evaluations = new AtomicInteger();
+        final List<Entity> candidates = Collections.nCopies(100, null);
+        final List<Entity> selected = filterCollisionCandidates(candidates, entity -> {
+            evaluations.incrementAndGet();
+            return true;
+        }, 16);
+
+        assertEquals(16, evaluations.get());
+        assertEquals(16, selected.size());
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {1, 8, 16, 1000})
+    void boundsMovementForTheReported376MinecartPile(final int configuredLimit) throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture(configuredLimit);
+        final List<CountingMinecart> carts = fixture.pile(376);
+        final int limit = Math.min(configuredLimit, 16);
+        int collisionChecks = 0;
+        for (CountingMinecart cart : carts) {
+            final List<Entity> unlimited = new ArrayList<>();
+            fixture.chunk(0, 0).getEntities(cart, cart.getBoundingBox(), unlimited, null);
+            assertEquals(375, unlimited.size());
+            final List<AABB> shapes = new ArrayList<>();
+            assertTrue(CollisionUtil.getEntityHardCollisions(fixture.level, cart, cart.getBoundingBox(), shapes, 0, null));
+            assertEquals(limit, shapes.size());
+            collisionChecks += cart.collisionChecks;
+            assertFalse(cart.isRemoved());
+        }
+        assertEquals(376 * limit, collisionChecks);
+    }
+
+    @Test
+    void sharesMovementBudgetAcrossBothSinksAndResetsNextTick() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture(8);
+        final CountingMinecart cart = fixture.pile(40).getFirst();
+        doCallRealMethod().when(fixture.level).getEntityCollisions(any(), any());
+        assertEquals(8, fixture.level.getEntityCollisions(cart, cart.getBoundingBox()).size());
+        final List<AABB> shapes = new ArrayList<>();
+        assertFalse(CollisionUtil.getEntityHardCollisions(fixture.level, cart, cart.getBoundingBox(), shapes, 0, null));
+        assertEquals(8, cart.collisionChecks);
+        fixture.tick++;
+        assertTrue(CollisionUtil.getEntityHardCollisions(fixture.level, cart, cart.getBoundingBox(), shapes, 0, null));
+        assertEquals(16, cart.collisionChecks);
+        assertEquals(8, shapes.size());
+    }
+
+    @Test
+    void chargesRejectedPredicatesAndReentrantQueries() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture(8);
+        final CountingMinecart cart = fixture.pile(40).getFirst();
+        final AtomicInteger predicates = new AtomicInteger();
+        assertTrue(cart.getHardCollisionEntities(cart.getBoundingBox(), entity -> {
+            predicates.incrementAndGet();
+            assertTrue(cart.getHardCollisionEntities(cart.getBoundingBox(), null).isEmpty());
+            return false;
+        }).isEmpty());
+        assertEquals(8, predicates.get());
+        assertTrue(cart.getHardCollisionEntities(cart.getBoundingBox(), null).isEmpty());
+        // Movement must not starve the independent push/pickup phase.
+        assertEquals(8, cart.pushCandidates(entity -> true).size());
+        assertTrue(cart.pushCandidates(entity -> true).isEmpty());
+    }
+
+    @Test
+    void preservesSmallQueriesAndCheckOnlySemantics() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture(8);
+        final CountingMinecart cart = fixture.pile(3).getFirst();
+        assertEquals(2, cart.getHardCollisionEntities(cart.getBoundingBox(), null).size());
+        assertTrue(CollisionUtil.getEntityHardCollisions(
+            fixture.level, cart, cart.getBoundingBox(), null, CollisionUtil.COLLISION_FLAG_CHECK_ONLY, null
+        ));
+        assertEquals(1, cart.collisionChecks);
+        assertEquals(2, cart.pushCandidates(entity -> true).size());
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {0, -1})
+    void disabledCollisionsDoNotScanOrEvaluatePredicates(final int configuredLimit) throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture(configuredLimit);
+        final CountingMinecart cart = fixture.pile(3).getFirst();
+        final Predicate<Entity> fail = entity -> { throw new AssertionError("Disabled collision predicate"); };
+        assertTrue(cart.getHardCollisionEntities(cart.getBoundingBox(), fail).isEmpty());
+        assertTrue(cart.pushCandidates(fail).isEmpty());
+        verify(fixture.lookup, never()).getChunk(anyInt(), anyInt());
+    }
+
+    @Test
+    void boundsNonintersectingCandidatesBeforeReadingTheirBoxes() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture(16);
+        final CountingMinecart cart = fixture.cart(8, 8, 8);
+        final AtomicInteger boxReads = new AtomicInteger();
+        for (int i = 0; i < 376; ++i) {
+            final Entity entity = mock(Entity.class);
+            when(entity.getId()).thenReturn(10_000 + i);
+            when(entity.getBoundingBox()).thenAnswer(invocation -> {
+                boxReads.incrementAndGet();
+                return new AABB(12, 8, 12, 13, 9, 13);
+            });
+            fixture.chunk(0, 0).addEntity(entity, 0);
+        }
+        assertTrue(cart.getHardCollisionEntities(cart.getBoundingBox(), null).isEmpty());
+        // One chunk visit, one section visit, and the source cart also use scan steps.
+        assertEquals(253, boxReads.get());
+        assertTrue(cart.getHardCollisionEntities(cart.getBoundingBox(), null).isEmpty());
+        assertEquals(253, boxReads.get());
+    }
