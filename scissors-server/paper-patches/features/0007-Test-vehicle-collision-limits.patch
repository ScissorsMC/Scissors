+package io.papermc.paper.scissors;
+
+import net.minecraft.world.level.entity.PersistentEntitySectionManager;
+import net.minecraft.world.level.entity.ChunkEntities;
+import net.minecraft.world.level.entity.Visibility;
+import net.minecraft.world.level.chunk.storage.EntityStorage;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import org.bukkit.craftbukkit.event.CraftEventFactory;
+import io.papermc.paper.configuration.WorldConfiguration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.entity.vehicle.boat.Boat;
+import net.minecraft.world.entity.vehicle.minecart.AbstractMinecart;
+import net.minecraft.world.entity.vehicle.minecart.Minecart;
+import net.minecraft.world.entity.vehicle.minecart.MinecartChest;
+import net.minecraft.world.entity.vehicle.minecart.MinecartCommandBlock;
+import net.minecraft.world.entity.vehicle.minecart.MinecartFurnace;
+import net.minecraft.world.entity.vehicle.minecart.MinecartHopper;
+import net.minecraft.world.entity.vehicle.minecart.MinecartSpawner;
+import net.minecraft.world.entity.vehicle.minecart.MinecartTNT;
+import net.minecraft.world.flag.FeatureFlags;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.entity.LevelCallback;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.spigotmc.SpigotWorldConfig;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@Normal
+class MinecartPopulationLimitTest {
+    private org.mockito.MockedStatic<org.spigotmc.AsyncCatcher> threadCheck;
+
+    @org.junit.jupiter.api.BeforeEach
+    void useTestThread() {
+        // The real section manager requires the server thread. This fixture does not start a server.
+        this.threadCheck = mockStatic(org.spigotmc.AsyncCatcher.class);
+    }
+
+    @org.junit.jupiter.api.AfterEach
+    void restoreThreadCheck() {
+        this.threadCheck.close();
+    }
+
+    @Test
+    void cancelsSpawnsAfterOneHundredWithoutRemovingAnyCarts() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        for (int i = 0; i < 3100; ++i) {
+            final Minecart cart = fixture.cart(0, i % 2 == 0 ? -32 : 300, 0);
+            cart.totalEntityAge = Integer.MAX_VALUE; // Age must not affect spawn admission.
+            assertEquals(i < 100, fixture.lookup.addNewEntity(cart));
+            assertFalse(cart.isRemoved());
+            assertEquals(Math.min(i + 1, 100), fixture.count(0, 0));
+            if (i >= 100) {
+                assertNull(fixture.lookup.getEntityGetter().get(cart.getId()));
+                assertNull(fixture.lookup.getEntityGetter().get(cart.getUUID()));
+            }
+        }
+        assertEquals(100, fixture.tracked.size());
+        assertEquals(100, fixture.lookup.count());
+        assertTrue(fixture.tracked.stream().noneMatch(Entity::isRemoved));
+    }
+
+    @Test
+    void rejectedDuplicateUuidDoesNotChangeTheCount() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        final Minecart original = fixture.fill(0, 0, 1).getFirst();
+        final Minecart duplicate = fixture.cart(8, 8, 8);
+        duplicate.setUUID(original.getUUID());
+        assertFalse(fixture.lookup.addNewEntity(duplicate));
+        assertEquals(1, fixture.count(0, 0));
+        assertSame(original, fixture.lookup.getEntityGetter().get(original.getUUID()));
+        assertFalse(duplicate.isRemoved());
+    }
+
+    @Test
+    void trackingCallbackCannotAdmitAnExtraCart() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(0, 0, 99);
+        final Minecart extra = fixture.cart(8, 8, 8);
+        doAnswer(invocation -> {
+            assertEquals(100, fixture.count(0, 0));
+            assertFalse(fixture.lookup.addNewEntity(extra));
+            return null;
+        }).when(fixture.callback).onTrackingStart(any());
+        assertTrue(fixture.lookup.addNewEntity(fixture.cart(8, 8, 8)));
+        assertEquals(100, fixture.count(0, 0));
+        assertFalse(extra.isRemoved());
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void leavesExistingSavedPilesAlone(final boolean legacy) throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        final List<Entity> saved = new ArrayList<>();
+        for (int i = 0; i < 3100; ++i) {
+            saved.add(fixture.cart(0, 8, 0));
+        }
+        if (legacy) {
+            fixture.lookup.addLegacyChunkEntities(saved.stream());
+        } else {
+            fixture.loads.get(ChunkPos.pack(0, 0)).complete(new ChunkEntities<>(new ChunkPos(0, 0), saved));
+            try (var events = mockStatic(CraftEventFactory.class)) {
+                fixture.lookup.processPendingLoads();
+            }
+        }
+        assertEquals(3100, fixture.count(0, 0));
+        assertEquals(3100, fixture.tracked.size());
+        assertTrue(saved.stream().noneMatch(Entity::isRemoved));
+        assertFalse(fixture.lookup.addNewEntity(fixture.cart(0, 8, 0)));
+        assertEquals(3100, fixture.count(0, 0));
+    }
+
+    @Test
+    void combinesAllMinecartTypesButLeavesOtherEntitiesAlone() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(0, 0, 94);
+        final List<AbstractMinecart> variants = List.of(
+            new MinecartChest(EntityTypes.CHEST_MINECART, fixture.level),
+            new MinecartHopper(EntityTypes.HOPPER_MINECART, fixture.level),
+            new MinecartFurnace(EntityTypes.FURNACE_MINECART, fixture.level),
+            new MinecartTNT(EntityTypes.TNT_MINECART, fixture.level),
+            new MinecartCommandBlock(EntityTypes.COMMAND_BLOCK_MINECART, fixture.level),
+            new MinecartSpawner(EntityTypes.SPAWNER_MINECART, fixture.level)
+        );
+        for (final AbstractMinecart cart : variants) {
+            assertTrue(fixture.lookup.addNewEntity(cart));
+        }
+        assertEquals(100, fixture.count(0, 0));
+        assertFalse(fixture.lookup.addNewEntity(new MinecartChest(EntityTypes.CHEST_MINECART, fixture.level)));
+        assertTrue(fixture.lookup.addNewEntity(new Boat(EntityTypes.OAK_BOAT, fixture.level, () -> Items.OAK_BOAT)));
+        assertEquals(101, fixture.lookup.count());
+    }
+
+    @Test
+    void keepsAdjacentChunksIndependentIncludingNegativeCoordinates() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(-1, 0, 100);
+        fixture.fill(0, 0, 100);
+        fixture.fill(1, 0, 100);
+        assertFalse(fixture.lookup.addNewEntity(fixture.cart(-1, 8, 0)));
+        assertEquals(100, fixture.count(-1, 0));
+        assertEquals(100, fixture.count(0, 0));
+        assertEquals(100, fixture.count(1, 0));
+    }
+
+    @Test
+    void countsMovingCartsWithoutBlockingOrRemovingThem() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(0, 0, 100);
+        final Minecart incoming = fixture.cart(24, 8, 0);
+        assertTrue(fixture.lookup.addNewEntity(incoming));
+        incoming.setPos(8, 8, 0);
+        assertFalse(incoming.isRemoved());
+        assertEquals(8, incoming.getX());
+        assertEquals(101, fixture.count(0, 0));
+        assertEquals(0, fixture.count(1, 0));
+        assertFalse(fixture.lookup.addNewEntity(fixture.cart(8, 8, 0)));
+        incoming.setPos(24, 8, 0);
+        assertEquals(100, fixture.count(0, 0));
+        assertEquals(1, fixture.count(1, 0));
+    }
+
+    @Test
+    void releasesSpawnSlotOnRemovalButNotOnVerticalMovement() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        final List<Minecart> carts = fixture.fill(0, 0, 100);
+        for (int y = -48; y < 300; y += 16) {
+            carts.getFirst().setPos(8, y, 0);
+            assertEquals(100, fixture.count(0, 0));
+        }
+        carts.getFirst().setRemoved(Entity.RemovalReason.DISCARDED, null);
+        assertEquals(99, fixture.count(0, 0));
+        final Minecart replacement = fixture.cart(0, 8, 0);
+        assertTrue(fixture.lookup.addNewEntity(replacement));
+        assertSame(replacement, fixture.lookup.getEntityGetter().get(replacement.getId()));
+        assertEquals(100, fixture.count(0, 0));
+    }
+
+    @Test
+    void preservesCountAcrossVisibilityChanges() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(0, 0, 100);
+        fixture.lookup.updateChunkStatus(new ChunkPos(0, 0), Visibility.HIDDEN);
+        assertEquals(100, fixture.count(0, 0));
+        fixture.lookup.updateChunkStatus(new ChunkPos(0, 0), Visibility.TICKING);
+        assertEquals(100, fixture.count(0, 0));
+        assertFalse(fixture.lookup.addNewEntity(fixture.cart(0, 8, 0)));
+    }
+
+    @Test
+    void preservesCargoWhenCancellingContainerCartSpawn() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(0, 0, 100);
+        final MinecartChest cart = new MinecartChest(EntityTypes.CHEST_MINECART, fixture.level);
+        cart.setItem(0, new ItemStack(Items.DIAMOND, 64));
+        assertFalse(fixture.lookup.addNewEntity(cart));
+        assertFalse(cart.isRemoved());
+        assertEquals(64, cart.getItem(0).getCount());
+        assertNull(fixture.lookup.getEntityGetter().get(cart.getUUID()));
+        verify(fixture.level, never()).addFreshEntity(any(Entity.class));
+        assertEquals(100, fixture.lookup.count());
+    }
+
+    @Test
+    void doesNotCancelExistingDimensionTransfers() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        fixture.fill(0, 0, 100);
+        final Minecart transferred = fixture.cart(8, 8, 0);
+        // ServerLevel passes false when there is no spawn event, as with dimension transfers.
+        assertTrue(fixture.lookup.addNewEntity(transferred, false));
+        assertFalse(transferred.isRemoved());
+        assertEquals(101, fixture.count(0, 0));
+        assertFalse(fixture.lookup.addNewEntity(fixture.cart(8, 8, 0)));
+    }
+
+    @Test
+    void releasesCountOnUnloadAndLimitsNewWorldgenCarts() throws ReflectiveOperationException {
+        final Fixture fixture = new Fixture();
+        for (final Minecart resident : fixture.fill(0, 0, 100)) {
+            resident.setRemoved(Entity.RemovalReason.UNLOADED_TO_CHUNK, null);
+        }
+        assertEquals(0, fixture.count(0, 0));
+        assertEquals(0, fixture.lookup.count());
+        final List<Entity> generated = new ArrayList<>();
+        for (int i = 0; i < 101; ++i) {
+            generated.add(fixture.cart(8, 8, 0));
+        }
+        fixture.lookup.addWorldGenChunkEntities(generated.stream());
+        assertEquals(100, fixture.count(0, 0));
+        assertNull(fixture.lookup.getEntityGetter().get(generated.getLast().getId()));
+        assertTrue(generated.stream().noneMatch(Entity::isRemoved));
+    }
+
+    private static final class Fixture {
+        final ServerLevel level = mock(ServerLevel.class);
+        final PersistentEntitySectionManager<Entity> lookup;
+        final LevelCallback<Entity> callback;
+        final Map<Long, CompletableFuture<ChunkEntities<Entity>>> loads = new HashMap<>();
+        final List<Entity> tracked = new ArrayList<>();
+
+        @SuppressWarnings("unchecked")
+        Fixture() throws ReflectiveOperationException {
+            final WorldConfiguration config = mock(WorldConfiguration.class);
+            config.entities = mock(WorldConfiguration.Entities.class);
+            config.entities.spawning = mock(WorldConfiguration.Entities.Spawning.class);
+            config.entities.spawning.despawnTime = new it.unimi.dsi.fastutil.objects.Reference2ObjectOpenHashMap<>();
+            config.scoreboards = mock(WorldConfiguration.Scoreboards.class);
+            when(this.level.paperConfig()).thenReturn(config);
+            final var spigotConfig = Level.class.getDeclaredField("spigotConfig");
+            spigotConfig.setAccessible(true);
+            spigotConfig.set(this.level, mock(SpigotWorldConfig.class));
+            when(this.level.enabledFeatures()).thenReturn(FeatureFlags.VANILLA_SET);
+            when(this.level.dimension()).thenReturn(Level.OVERWORLD);
+            when(this.level.getMinSectionY()).thenReturn(-4);
+            when(this.level.getMaxSectionY()).thenReturn(19);
+            final AtomicInteger ids = new AtomicInteger();
+            when(this.level.getNextEntityId()).thenAnswer(invocation -> ids.incrementAndGet());
+            this.callback = mock(LevelCallback.class);
+            final EntityStorage storage = mock(EntityStorage.class);
+            when(storage.loadEntities(any())).thenAnswer(invocation -> {
+                final ChunkPos pos = invocation.getArgument(0);
+                return this.loads.computeIfAbsent(pos.pack(), key -> new CompletableFuture<>());
+            });
+            this.lookup = new PersistentEntitySectionManager<>(Entity.class, callback, storage);
+            when(this.level.getEntities()).thenReturn(this.lookup.getEntityGetter());
+            for (int x = -1; x <= 1; ++x) {
+                this.lookup.updateChunkStatus(new ChunkPos(x, 0), Visibility.TICKING);
+            }
+            doAnswer(invocation -> {
+                final Entity entity = invocation.getArgument(0);
+                this.tracked.add(entity);
+                return null;
+            }).when(callback).onTrackingStart(any());
+        }
+
+        Minecart cart(final int x, final int y, final int z) {
+            final Minecart cart = new Minecart(EntityTypes.MINECART, this.level);
+            cart.setPos(x, y, z);
+            return cart;
+        }
+
+        List<Minecart> fill(final int chunkX, final int chunkZ, final int count) {
+            final List<Minecart> carts = new ArrayList<>();
+            for (int i = 0; i < count; ++i) {
+                final Minecart cart = this.cart(chunkX * 16 + 8, 8, chunkZ * 16 + 8);
+                assertTrue(this.lookup.addNewEntity(cart));
+                carts.add(cart);
+            }
+            return carts;
+        }
+
+        int count(final int x, final int z) {
+            return this.lookup.getMinecartCount(ChunkPos.pack(x, z));
+        }
+    }
+}
diff --git a/src/test/java/io/papermc/paper/scissors/VehicleCollisionLimitTest.java b/src/test/java/io/papermc/paper/scissors/VehicleCollisionLimitTest.java
