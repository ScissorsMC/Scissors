+        }
+        // None of the stored carts intersect this box, but the search visits their sections.
+        final AABB box = new AABB(-16, 0, 0, 31, 256, 1);
+        final VehicleEntity.CollisionBudget budget = new VehicleEntity.CollisionBudget();
+        budget.reset(0, 16);
+        final List<Entity> candidates = new ArrayList<>();
+        int queries = 0;
+        while (!fixture.lookup.getVehicleCollisionEntities(cart, box, candidates, 17, false, budget)) {
+            assertTrue(++queries < 10);
+        }
+        assertTrue(candidates.isEmpty());
+        assertFalse(budget.tryScan());
+        budget.reset(0, 16);
+        assertFalse(budget.tryScan());
+        budget.reset(1, 16);
+        assertTrue(budget.tryScan());
+    }
