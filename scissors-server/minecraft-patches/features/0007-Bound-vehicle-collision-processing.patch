+    // Scissors - count every visited entity, including entities outside the box.
+    public boolean getVehicleCollisionEntities(final T except, final AABB box, final java.util.List<T> into, final int maxCount,
+        final net.minecraft.world.entity.vehicle.VehicleEntity.CollisionBudget budget) {
+        for (T entity : this.storage) {
+            if (!budget.tryScan()) {
+                return true;
+            }
+            if (entity != except && entity.getBoundingBox().intersects(box)) {
+                into.add(entity);
+                if (into.size() >= maxCount) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
