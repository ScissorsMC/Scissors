index f853c217ec89f9d23f00aa1551272271ea24fbe6..c15b6d72f3dfff0dca5de177b5a58461a290a097 100644
--- a/net/minecraft/world/level/entity/EntitySectionStorage.java
+++ b/net/minecraft/world/level/entity/EntitySectionStorage.java
@@ -92,6 +92,42 @@ public class EntitySectionStorage<T extends EntityAccess> {
         );
     }
 
+    // Scissors - bound traversal as well as results; an empty or nonintersecting region still costs work.
+    public boolean getVehicleCollisionEntities(final T except, final AABB bb, final java.util.List<T> into, final int maxCount,
+        final net.minecraft.world.entity.vehicle.VehicleEntity.CollisionBudget budget) {
+        int xMin = SectionPos.posToSectionCoord(bb.minX - 2.0);
+        int yMin = SectionPos.posToSectionCoord(bb.minY - 4.0);
+        int zMin = SectionPos.posToSectionCoord(bb.minZ - 2.0);
+        int xMax = SectionPos.posToSectionCoord(bb.maxX + 2.0);
+        int yMax = SectionPos.posToSectionCoord(bb.maxY);
+        int zMax = SectionPos.posToSectionCoord(bb.maxZ + 2.0);
+        for (int x = xMin; x <= xMax; x++) {
+            if (!budget.tryScan()) {
+                return true;
+            }
+            long lowest = SectionPos.asLong(x, 0, 0);
+            long highest = SectionPos.asLong(x, -1, -1);
+            LongIterator sections = this.sectionIds.subSet(lowest, highest + 1L).iterator();
+            while (sections.hasNext()) {
+                if (!budget.tryScan()) {
+                    return true;
+                }
+                long key = sections.nextLong();
+                int y = SectionPos.y(key);
+                int z = SectionPos.z(key);
+                if (y < yMin || y > yMax || z < zMin || z > zMax) {
+                    continue;
+                }
+                EntitySection<T> section = this.sections.get(key);
+                if (section != null && section.getStatus().isAccessible()
+                    && section.getVehicleCollisionEntities(except, bb, into, maxCount, budget)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
