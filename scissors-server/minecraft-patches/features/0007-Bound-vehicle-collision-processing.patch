+    private List<Entity> getCollisionEntities(
+        final AABB hitbox, final @Nullable Predicate<? super Entity> predicate, final CollisionBudget budget, final boolean hardOnly
+    ) {
+        int configuredLimit = this.level().isClientSide() ? MAX_VEHICLE_COLLISIONS : this.level().paperConfig().collisions.maxEntityCollisions;
+        int collisionLimit = collisionLimit(configuredLimit);
+        if (collisionLimit == 0) {
+            return List.of();
+        }
+
+        // Movement can query repeatedly in one tick. Do not renew the budget at each query or rail step.
+        budget.reset(this.level().getGameTime(), collisionLimit);
+        int remaining = budget.remainingCandidates;
+        if (remaining == 0 || budget.remainingScanSteps == 0) {
+            this.warnCollisionOverflow(budget, collisionLimit);
+            return List.of();
+        }
+
+        List<Entity> candidates = new ArrayList<>(remaining + 1);
+        // Dragon parts are neither pushable nor hard colliders. Avoid Paper's global part scan here.
+        boolean truncated = ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this.level())
+            .moonrise$getEntityLookup().getVehicleCollisionEntities(
+                this, hitbox, candidates, remaining + 1, hardOnly, budget
+        );
+        // Charge raw candidates before predicates or events can make a reentrant query.
+        int examined = Math.min(candidates.size(), remaining);
+        budget.remainingCandidates -= examined;
+        if (truncated) {
+            this.warnCollisionOverflow(budget, collisionLimit);
+        }
+        return filterCollisionCandidates(candidates, predicate, examined);
+    }
+
+    private void warnCollisionOverflow(final CollisionBudget budget, final int collisionLimit) {
+        if (!budget.warned && !this.level().isClientSide()) {
+            budget.warned = true;
+            long now = Util.getMillis();
+            long nextWarning = NEXT_COLLISION_OVERFLOW_WARNING.get();
+            if (now >= nextWarning
+                && NEXT_COLLISION_OVERFLOW_WARNING.compareAndSet(nextWarning, now + COLLISION_OVERFLOW_WARNING_INTERVAL)) {
+                LOGGER.warn(
+                    "Skipped excess vehicle collision work for {} with UUID {} at {} in {}. Limit per vehicle per tick: {} candidates and {} scan steps for each of movement and push/pickup checks. Suppressing further vehicle collision warnings for 5 minutes",
+                    this.getType(),
+                    this.getUUID(),
+                    this.blockPosition().toShortString(),
+                    this.level().dimension().identifier(),
+                    collisionLimit,
+                    MAX_COLLISION_SCAN_STEPS
+                );
+            }
+        }
+    }
+
+    static int collisionLimit(final int configuredLimit) {
+        return Math.max(0, Math.min(configuredLimit, MAX_VEHICLE_COLLISIONS));
+    }
+
+    static List<Entity> filterCollisionCandidates(
+        final List<Entity> candidates, final @Nullable Predicate<? super Entity> predicate, final int collisionLimit
+    ) {
+        int examinedCandidates = Math.min(candidates.size(), collisionLimit);
+        List<Entity> entities = new ArrayList<>(examinedCandidates);
+        for (int i = 0; i < examinedCandidates; i++) {
+            Entity entity = candidates.get(i);
+            if (predicate == null || predicate.test(entity)) {
+                entities.add(entity);
+            }
+        }
+        return entities;
+    }
+
+    // Keep movement separate so that movement checks cannot consume the push/pickup budget.
+    public static final class CollisionBudget {
+        private long tick = Long.MIN_VALUE;
+        private int remainingCandidates;
+        private int remainingScanSteps;
+        private boolean warned;
+
+        public void reset(final long tick, final int configuredLimit) {
+            if (this.tick != tick) {
+                this.tick = tick;
+                this.remainingCandidates = collisionLimit(configuredLimit);
+                this.remainingScanSteps = this.remainingCandidates == 0 ? 0 : MAX_COLLISION_SCAN_STEPS;
+                this.warned = false;
+            }
+        }
+
+        // Count chunk, section and entity visits, including entities outside the query box.
+        public boolean tryScan() {
+            if (this.remainingScanSteps == 0) {
+                return false;
+            }
+            --this.remainingScanSteps;
+            return true;
+        }
+    }
+    // Scissors end - bound collision queries without destroying legitimate crowded vehicles
