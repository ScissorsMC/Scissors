From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telesphoreo <me@telesphoreo.me>
Date: Wed, 29 Jul 2026 00:55:22 -0400
Subject: [PATCH] Bound vehicle collision processing

Boat and both minecart movement implementations previously materialized and processed every nearby entity. Stop entity lookup after the configured limit or a hard cap of 16, preserve the vehicles, and rate-limit overflow logging.

diff --git a/net/minecraft/world/entity/vehicle/VehicleEntity.java b/net/minecraft/world/entity/vehicle/VehicleEntity.java
index 96b0fa2ebab15a939a5162d23b3ad9b92365d818..9d9aa40526fa6c7117a15312ce412d9e86605c41 100644
--- a/net/minecraft/world/entity/vehicle/VehicleEntity.java
+++ b/net/minecraft/world/entity/vehicle/VehicleEntity.java
@@ -1,5 +1,9 @@
 package net.minecraft.world.entity.vehicle;
 
+import com.mojang.logging.LogUtils;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Predicate;
 import net.minecraft.core.component.DataComponents;
 import net.minecraft.network.syncher.EntityDataAccessor;
 import net.minecraft.network.syncher.EntityDataSerializers;
@@ -16,11 +20,18 @@ import net.minecraft.world.level.Explosion;
 import net.minecraft.world.level.Level;
 import net.minecraft.world.level.gameevent.GameEvent;
 import net.minecraft.world.level.gamerules.GameRules;
+import net.minecraft.world.level.entity.EntityTypeTest;
+import net.minecraft.world.phys.AABB;
+import org.slf4j.Logger;
 
 public abstract class VehicleEntity extends Entity {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final int MAX_VEHICLE_COLLISIONS = 16;
+    private static final int COLLISION_OVERFLOW_WARNING_INTERVAL_TICKS = 100;
     protected static final EntityDataAccessor<Integer> DATA_ID_HURT = SynchedEntityData.defineId(VehicleEntity.class, EntityDataSerializers.INT);
     protected static final EntityDataAccessor<Integer> DATA_ID_HURTDIR = SynchedEntityData.defineId(VehicleEntity.class, EntityDataSerializers.INT);
     protected static final EntityDataAccessor<Float> DATA_ID_DAMAGE = SynchedEntityData.defineId(VehicleEntity.class, EntityDataSerializers.FLOAT);
+    private int nextCollisionOverflowWarningTick;
 
     public VehicleEntity(final EntityType<?> type, final Level level) {
         super(type, level);
@@ -131,6 +142,39 @@ public abstract class VehicleEntity extends Entity {
         return this.entityData.get(DATA_ID_HURTDIR);
     }
 
+    // Scissors start - bound collision queries without destroying legitimate crowded vehicles
+    protected List<Entity> getCollisionEntities(final AABB hitbox, final Predicate<? super Entity> predicate) {
+        int configuredLimit = this.level().isClientSide() ? MAX_VEHICLE_COLLISIONS : this.level().paperConfig().collisions.maxEntityCollisions;
+        int collisionLimit = collisionLimit(configuredLimit);
+        List<Entity> entities = new ArrayList<>(collisionLimit + 1);
+        this.level().getEntities(
+            EntityTypeTest.forClass(Entity.class),
+            hitbox,
+            entity -> entity != this && predicate.test(entity),
+            entities,
+            collisionLimit + 1
+        );
+        if (entities.size() > collisionLimit) {
+            if (!this.level().isClientSide() && this.tickCount >= this.nextCollisionOverflowWarningTick) {
+                this.nextCollisionOverflowWarningTick = this.tickCount + COLLISION_OVERFLOW_WARNING_INTERVAL_TICKS;
+                LOGGER.warn(
+                    "Limited collision processing for {} with UUID {} at {} to {} entities",
+                    this.getType(),
+                    this.getUUID(),
+                    this.blockPosition().toShortString(),
+                    collisionLimit
+                );
+            }
+            return entities.subList(0, collisionLimit);
+        }
+        return entities;
+    }
+
+    static int collisionLimit(final int configuredLimit) {
+        return configuredLimit > 0 ? Math.min(configuredLimit, MAX_VEHICLE_COLLISIONS) : MAX_VEHICLE_COLLISIONS;
+    }
+    // Scissors end - bound collision queries without destroying legitimate crowded vehicles
+
     protected void destroy(final ServerLevel level, final DamageSource source) {
         this.destroy(level, this.getDropItem());
     }
