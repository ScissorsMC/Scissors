     // Paper end - Force update attributes.
 
+    // Scissors start - recover hidden equipment and remove its effects automatically
+    @Override
+    public boolean canUseSlot(final EquipmentSlot slot) {
+        return io.github.scissorsmc.util.UnsafeEquipment.isPlayerSlot(slot);
+    }
+
+    private boolean repairUnsafeEquipment() {
+        boolean repaired = this.equipmentRecoveryPending;
+        this.equipmentRecoveryPending = false;
+        if (repaired) {
+            this.refreshRecoveredEquipmentEffects = true;
+            this.setDeltaMovement(net.minecraft.world.phys.Vec3.ZERO);
+        }
+        for (java.util.Iterator<ItemStack> pending = this.recoveredEquipment.iterator(); pending.hasNext();) {
+            ItemStack item = pending.next();
+            while (!item.isEmpty()) {
+                int slot = this.inventory.getSlotWithRemainingSpace(item);
+                if (slot == Inventory.NOT_FOUND_INDEX) slot = this.inventory.getFreeSlot();
+                if (slot == Inventory.NOT_FOUND_INDEX) break;
+                ItemStack existing = this.inventory.getItem(slot);
+                int room = Math.min(item.getMaxStackSize(), this.inventory.getMaxStackSize()) - existing.getCount();
+                int count = Math.min(room, item.getCount());
+                if (count <= 0) break;
+                if (existing.isEmpty()) this.inventory.setItem(slot, item.split(count));
+                else { existing.grow(count); item.shrink(count); }
+                this.inventory.setChanged();
+                repaired = true;
+            }
+            if (item.isEmpty()) pending.remove();
+        }
+        return repaired;
+    }
+
+    void recoverUnsupportedEquipment(final EquipmentSlot slot, final ItemStack item) {
+        this.stopLocationBasedEffects(item, slot, this.getAttributes());
+        if (this.recoveredEquipment.size() < MAX_RECOVERED_EQUIPMENT) {
+            this.recoveredEquipment.add(ItemStack.sanitizeUnsafeData(item).copy());
+        } else {
+            io.github.scissorsmc.util.UnsafeEquipment.warn("Discarded excess unsupported player equipment for " + this.getUUID());
+        }
+        this.equipmentRecoveryPending = true;
+        com.mojang.logging.LogUtils.getLogger().warn("Recovered unsupported {} equipment for player {} ({}); removed its attribute and enchantment effects", slot.getSerializedName(), this.getGameProfile().name(), this.getUUID());
+    }
+
+    boolean isLoadingEquipment() {
+        return this.loadingEquipment;
+    }
+
+    protected void restoreRecoveredEquipment(final Player oldPlayer) {
+        if (oldPlayer == this) return;
+        this.recoveredEquipment.addAll(oldPlayer.recoveredEquipment);
+        oldPlayer.recoveredEquipment.clear();
+    }
+    // Scissors end - recover hidden equipment and remove its effects automatically
+
