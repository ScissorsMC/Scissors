From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telesphoreo <me@telesphoreo.me>
Date: Sat, 29 Aug 2026 22:54:10 -0400
Subject: [PATCH] Sanitize overflowing instant potion amplifiers

Cap custom instant health and damage potion amplifiers at the largest vanilla level, and use saturating arithmetic at the effect sink so raw callers cannot turn healing negative through an overflowing shift.

diff --git a/net/minecraft/world/effect/HealOrHarmMobEffect.java b/net/minecraft/world/effect/HealOrHarmMobEffect.java
index f5e89c81a4aae3cbbe85e0ebb0ac1adfc51f0de3..4f68559f79650b8528eb2daf95df3673dca3c5f6 100644
--- a/net/minecraft/world/effect/HealOrHarmMobEffect.java
+++ b/net/minecraft/world/effect/HealOrHarmMobEffect.java
@@ -1,6 +1,7 @@
 package net.minecraft.world.effect;
 
 import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.Mth;
 import net.minecraft.world.entity.Entity;
 import net.minecraft.world.entity.LivingEntity;
 import org.jspecify.annotations.Nullable;
@@ -16,9 +17,11 @@ class HealOrHarmMobEffect extends InstantaneousMobEffect {
     @Override
     public boolean applyEffectTick(final ServerLevel level, final LivingEntity mob, final int amplification) {
         if (this.isHarm == mob.isInvertedHealAndHarm()) {
-            mob.heal(Math.max(4 << amplification, 0), org.bukkit.event.entity.EntityRegainHealthEvent.RegainReason.MAGIC); // CraftBukkit
+            // Scissors start - prevent amplifier shift overflow
+            mob.heal(calculateEffectAmount(4, amplification, 1.0), org.bukkit.event.entity.EntityRegainHealthEvent.RegainReason.MAGIC); // CraftBukkit
+            // Scissors end - prevent amplifier shift overflow
         } else {
-            mob.hurtServer(level, mob.damageSources().magic(), 6 << amplification);
+            mob.hurtServer(level, mob.damageSources().magic(), calculateEffectAmount(6, amplification, 1.0)); // Scissors - prevent amplifier shift overflow
         }
 
         return true;
@@ -35,10 +38,10 @@ class HealOrHarmMobEffect extends InstantaneousMobEffect {
     ) {
         if (!new io.papermc.paper.event.entity.EntityEffectTickEvent(mob.getBukkitLivingEntity(), org.bukkit.craftbukkit.potion.CraftPotionEffectType.minecraftToBukkit(this), amplification).callEvent()) { return; } // Paper - Add EntityEffectTickEvent
         if (this.isHarm == mob.isInvertedHealAndHarm()) {
-            int amount = (int)(scale * (4 << amplification) + 0.5);
+            int amount = calculateEffectAmount(4, amplification, scale); // Scissors - prevent amplifier shift overflow
             mob.heal(amount, org.bukkit.event.entity.EntityRegainHealthEvent.RegainReason.MAGIC); // CraftBukkit
         } else {
-            int amount = (int)(scale * (6 << amplification) + 0.5);
+            int amount = calculateEffectAmount(6, amplification, scale); // Scissors - prevent amplifier shift overflow
             if (source == null) {
                 mob.hurtServer(serverLevel, mob.damageSources().magic(), amount);
             } else {
@@ -46,4 +49,21 @@ class HealOrHarmMobEffect extends InstantaneousMobEffect {
             }
         }
     }
+
+    // Scissors start - prevent instant health/damage amplifier shift overflow
+    static int calculateEffectAmount(final int baseAmount, final int amplification, final double scale) {
+        if (!(scale > 0.0)) {
+            return 0;
+        }
+
+        double amount = scale * Math.scalb(
+            (double)baseAmount,
+            Mth.clamp(amplification, MobEffectInstance.MIN_AMPLIFIER, MobEffectInstance.MAX_AMPLIFIER)
+        );
+        if (amount >= Integer.MAX_VALUE) {
+            return Integer.MAX_VALUE;
+        }
+        return Math.max((int)(amount + 0.5), 0);
+    }
+    // Scissors end - prevent instant health/damage amplifier shift overflow
 }
