diff --git a/net/minecraft/world/item/alchemy/PotionContents.java b/net/minecraft/world/item/alchemy/PotionContents.java
index d67173c468a22d8203f3313bfd25ae23a7e0323a..483c90ee3659f45041b9ed02ddefb3d86b75d41f 100644
--- a/net/minecraft/world/item/alchemy/PotionContents.java
+++ b/net/minecraft/world/item/alchemy/PotionContents.java
@@ -66,6 +66,25 @@ public record PotionContents(Optional<Holder<Potion>> potion, Optional<Integer>
         PotionContents::new
     );
 
+    // Scissors start - eliminate unsafe custom instant potion amplifiers at every potion boundary
+    public PotionContents sanitizeUnsafeEffects() {
+        List<MobEffectInstance> sanitizedEffects = null;
+        for (int i = 0; i < this.customEffects.size(); i++) {
+            MobEffectInstance effect = this.customEffects.get(i);
+            MobEffectInstance sanitized = MobEffectInstance.sanitizeForPotion(effect);
+            if (sanitized != effect && sanitizedEffects == null) {
+                sanitizedEffects = new java.util.ArrayList<>(this.customEffects.subList(0, i));
+            }
+            if (sanitizedEffects != null) {
+                sanitizedEffects.add(sanitized);
+            }
+        }
+        return sanitizedEffects == null
+            ? this
+            : new PotionContents(this.potion, this.customColor, List.copyOf(sanitizedEffects), this.customName);
+    }
+    // Scissors end - eliminate unsafe custom instant potion amplifiers at every potion boundary
+
     public PotionContents(final Holder<Potion> potion) {
         this(Optional.of(potion), Optional.empty(), List.of(), Optional.empty());
     }
