 import net.minecraft.network.codec.ByteBufCodecs;
 import net.minecraft.network.codec.StreamCodec;
@@ -24,6 +27,10 @@ import org.slf4j.Logger;
 
 public class MobEffectInstance implements Comparable<MobEffectInstance> {
     private static final Logger LOGGER = LogUtils.getLogger();
+    // Scissors start - sanitize unsafe custom instant potion amplifiers
+    private static final int MAX_SAFE_CUSTOM_INSTANT_POTION_AMPLIFIER = 1;
+    private static final AtomicLong NEXT_UNSAFE_CUSTOM_POTION_WARNING_NANOS = new AtomicLong();
+    // Scissors end - sanitize unsafe custom instant potion amplifiers
     public static final int INFINITE_DURATION = -1;
     public static final int MIN_AMPLIFIER = 0;
     public static final int MAX_AMPLIFIER = 255;
@@ -209,6 +216,45 @@ public class MobEffectInstance implements Comparable<MobEffectInstance> {
         return this.amplifier;
     }
 
+    // Scissors start - sanitize unsafe custom instant potion amplifiers
+    /**
+     * Returns an effect safe to carry in potion contents. Vanilla instant health and damage potions use at most
+     * amplifier {@code 1}; larger custom values can overflow the shift-based effect calculation. Other effect types
+     * are unchanged.
+     */
+    public static MobEffectInstance sanitizeForPotion(final MobEffectInstance instance) {
+        if (!(instance.effect.value() instanceof HealOrHarmMobEffect)
+            || instance.amplifier <= MAX_SAFE_CUSTOM_INSTANT_POTION_AMPLIFIER) {
+            return instance;
+        }
+
+        MobEffectInstance sanitized = new MobEffectInstance(
+            instance.effect,
+            instance.duration,
+            MAX_SAFE_CUSTOM_INSTANT_POTION_AMPLIFIER,
+            instance.ambient,
+            instance.visible,
+            instance.showIcon,
+            instance.hiddenEffect == null ? null : new MobEffectInstance(instance.hiddenEffect)
+        );
+        warnUnsafeCustomPotionAmplifier(instance);
+        return sanitized;
+    }
+
+    private static void warnUnsafeCustomPotionAmplifier(final MobEffectInstance instance) {
+        long now = System.nanoTime();
+        long nextWarning = NEXT_UNSAFE_CUSTOM_POTION_WARNING_NANOS.get();
+        if (now >= nextWarning && NEXT_UNSAFE_CUSTOM_POTION_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10L))) {
+            LOGGER.warn(
+                "Reduced unsafe custom potion effect {} amplifier from {} to {}; higher instant health/damage amplifiers can overflow effect arithmetic",
+                BuiltInRegistries.MOB_EFFECT.getKey(instance.effect.value()),
+                instance.amplifier,
+                MAX_SAFE_CUSTOM_INSTANT_POTION_AMPLIFIER
+            );
+        }
+    }
+    // Scissors end - sanitize unsafe custom instant potion amplifiers
+
     public boolean isAmbient() {
         return this.ambient;
     }
