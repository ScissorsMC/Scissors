 package net.minecraft.world.item.component;
 
+import com.mojang.logging.LogUtils;
 import com.mojang.serialization.Codec;
 import com.mojang.serialization.codecs.RecordCodecBuilder;
+import java.util.Collections;
+import java.util.LinkedHashMap;
 import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
 import net.minecraft.core.Holder;
 import net.minecraft.util.Util;
 import net.minecraft.world.level.saveddata.maps.MapDecorationType;
+import org.slf4j.Logger;
 
 public record MapDecorations(Map<String, MapDecorations.Entry> decorations) {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final AtomicLong NEXT_DECORATION_WARNING_NANOS = new AtomicLong();
+    public static final int MAX_DECORATIONS = 256;
     public static final MapDecorations EMPTY = new MapDecorations(Map.of());
     public static final Codec<MapDecorations> CODEC = Codec.unboundedMap(Codec.STRING, MapDecorations.Entry.CODEC)
         .xmap(MapDecorations::new, MapDecorations::decorations);
 
+    // Scissors start - eliminate excessive item decorations at their persistent component boundary
+    public MapDecorations {
+        if (decorations.size() > MAX_DECORATIONS) {
+            long now = System.nanoTime();
+            long nextWarning = NEXT_DECORATION_WARNING_NANOS.get();
+            if (now >= nextWarning && NEXT_DECORATION_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10))) {
+                LOGGER.warn(
+                    "Discarded {} excess map decorations from an item component; maximum is {}",
+                    decorations.size() - MAX_DECORATIONS,
+                    MAX_DECORATIONS
+                );
+            }
+        }
+        LinkedHashMap<String, MapDecorations.Entry> sanitized = new LinkedHashMap<>(Math.min(decorations.size(), MAX_DECORATIONS));
+        decorations.entrySet().stream().limit(MAX_DECORATIONS).forEach(entry -> sanitized.put(entry.getKey(), entry.getValue()));
+        decorations = Collections.unmodifiableMap(sanitized);
+    }
+    // Scissors end - eliminate excessive item decorations at their persistent component boundary
+
     public MapDecorations withDecoration(final String id, final MapDecorations.Entry entry) {
         return new MapDecorations(Util.copyAndPut(this.decorations, id, entry));
     }
