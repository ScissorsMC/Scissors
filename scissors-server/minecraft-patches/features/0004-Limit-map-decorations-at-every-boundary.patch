From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telesphoreo <me@telesphoreo.me>
Date: Wed, 29 Jul 2026 00:36:05 -0400
Subject: [PATCH] Limit map decorations at every boundary

Oversized decoration components can be copied into map state and emitted as unbounded client packets. Preserve the first 256 valid decorations at component construction, saved-map insertion, and final packet creation while logging discarded entries.

diff --git a/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java b/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java
index 27398fd91bc89daa030f77cf354ba382bdf80dad..52365f013862427f4cb8c3bdbb54a96b53a6e722 100644
--- a/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java
@@ -1,8 +1,11 @@
 package net.minecraft.network.protocol.game;
 
+import com.mojang.logging.LogUtils;
 import java.util.Collection;
 import java.util.List;
 import java.util.Optional;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
 import net.minecraft.network.RegistryFriendlyByteBuf;
 import net.minecraft.network.codec.ByteBufCodecs;
 import net.minecraft.network.codec.StreamCodec;
@@ -11,11 +14,15 @@ import net.minecraft.network.protocol.PacketType;
 import net.minecraft.world.level.saveddata.maps.MapDecoration;
 import net.minecraft.world.level.saveddata.maps.MapId;
 import net.minecraft.world.level.saveddata.maps.MapItemSavedData;
+import net.minecraft.world.item.component.MapDecorations;
 import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
 
 public record ClientboundMapItemDataPacket(
     MapId mapId, byte scale, boolean locked, Optional<List<MapDecoration>> decorations, Optional<MapItemSavedData.MapPatch> colorPatch
 ) implements Packet<ClientGamePacketListener> {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final AtomicLong NEXT_DECORATION_WARNING_NANOS = new AtomicLong();
     public static final StreamCodec<RegistryFriendlyByteBuf, ClientboundMapItemDataPacket> STREAM_CODEC = StreamCodec.composite(
         MapId.STREAM_CODEC,
         ClientboundMapItemDataPacket::mapId,
@@ -30,6 +37,29 @@ public record ClientboundMapItemDataPacket(
         ClientboundMapItemDataPacket::new
     );
 
+    // Scissors start - enforce the map decoration limit at the final client boundary too
+    public ClientboundMapItemDataPacket {
+        decorations = decorations.map(ClientboundMapItemDataPacket::sanitizeDecorations);
+    }
+
+    private static List<MapDecoration> sanitizeDecorations(final List<MapDecoration> decorations) {
+        if (decorations.size() <= MapDecorations.MAX_DECORATIONS) {
+            return List.copyOf(decorations);
+        }
+
+        long now = System.nanoTime();
+        long nextWarning = NEXT_DECORATION_WARNING_NANOS.get();
+        if (now >= nextWarning && NEXT_DECORATION_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10))) {
+            LOGGER.warn(
+                "Discarded {} excess decorations from an outgoing map packet; maximum is {}",
+                decorations.size() - MapDecorations.MAX_DECORATIONS,
+                MapDecorations.MAX_DECORATIONS
+            );
+        }
+        return List.copyOf(decorations.subList(0, MapDecorations.MAX_DECORATIONS));
+    }
+    // Scissors end - enforce the map decoration limit at the final client boundary too
+
     public ClientboundMapItemDataPacket(
         final MapId mapId,
         final byte scale,
diff --git a/net/minecraft/world/item/component/MapDecorations.java b/net/minecraft/world/item/component/MapDecorations.java
index 4b6d7817847a3105c744723c85b1cf9955b3847e..41d39dd181b5ba55beaf76a001d606df87b8c622 100644
--- a/net/minecraft/world/item/component/MapDecorations.java
+++ b/net/minecraft/world/item/component/MapDecorations.java
@@ -1,17 +1,38 @@
 package net.minecraft.world.item.component;
 
+import com.mojang.logging.LogUtils;
 import com.mojang.serialization.Codec;
 import com.mojang.serialization.codecs.RecordCodecBuilder;
+import java.util.Collections;
+import java.util.LinkedHashMap;
 import java.util.Map;
 import net.minecraft.core.Holder;
 import net.minecraft.util.Util;
 import net.minecraft.world.level.saveddata.maps.MapDecorationType;
+import org.slf4j.Logger;
 
 public record MapDecorations(Map<String, MapDecorations.Entry> decorations) {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    public static final int MAX_DECORATIONS = 256;
     public static final MapDecorations EMPTY = new MapDecorations(Map.of());
     public static final Codec<MapDecorations> CODEC = Codec.unboundedMap(Codec.STRING, MapDecorations.Entry.CODEC)
         .xmap(MapDecorations::new, MapDecorations::decorations);
 
+    // Scissors start - eliminate excessive item decorations at their persistent component boundary
+    public MapDecorations {
+        if (decorations.size() > MAX_DECORATIONS) {
+            LOGGER.warn(
+                "Discarded {} excess map decorations from an item component; maximum is {}",
+                decorations.size() - MAX_DECORATIONS,
+                MAX_DECORATIONS
+            );
+        }
+        LinkedHashMap<String, MapDecorations.Entry> sanitized = new LinkedHashMap<>(Math.min(decorations.size(), MAX_DECORATIONS));
+        decorations.entrySet().stream().limit(MAX_DECORATIONS).forEach(entry -> sanitized.put(entry.getKey(), entry.getValue()));
+        decorations = Collections.unmodifiableMap(sanitized);
+    }
+    // Scissors end - eliminate excessive item decorations at their persistent component boundary
+
     public MapDecorations withDecoration(final String id, final MapDecorations.Entry entry) {
         return new MapDecorations(Util.copyAndPut(this.decorations, id, entry));
     }
