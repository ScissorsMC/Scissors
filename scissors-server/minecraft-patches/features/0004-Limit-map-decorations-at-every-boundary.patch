From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telesphoreo <me@telesphoreo.me>
Date: Wed, 29 Jul 2026 00:36:05 -0400
Subject: [PATCH] Limit map decorations at every boundary

Cap persistent and outgoing map decoration collections at 256 entries. At the final client boundary, strip names beyond 32 visible characters or 64 component nodes and refuse interactive or unsupported component contents so stored or plugin-created payloads cannot bypass sanitation.

diff --git a/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java b/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java
index 27398fd91bc89daa030f77cf354ba382bdf80dad..de82c5f461963eae91ce421a1585b76c9aa93f4f 100644
--- a/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundMapItemDataPacket.java
@@ -1,21 +1,36 @@
 package net.minecraft.network.protocol.game;
 
+import com.mojang.logging.LogUtils;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
 import java.util.Collection;
 import java.util.List;
 import java.util.Optional;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
 import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.contents.KeybindContents;
+import net.minecraft.network.chat.contents.PlainTextContents;
+import net.minecraft.network.chat.contents.TranslatableContents;
 import net.minecraft.network.codec.ByteBufCodecs;
 import net.minecraft.network.codec.StreamCodec;
 import net.minecraft.network.protocol.Packet;
 import net.minecraft.network.protocol.PacketType;
+import net.minecraft.world.item.component.MapDecorations;
 import net.minecraft.world.level.saveddata.maps.MapDecoration;
 import net.minecraft.world.level.saveddata.maps.MapId;
 import net.minecraft.world.level.saveddata.maps.MapItemSavedData;
 import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
 
 public record ClientboundMapItemDataPacket(
     MapId mapId, byte scale, boolean locked, Optional<List<MapDecoration>> decorations, Optional<MapItemSavedData.MapPatch> colorPatch
 ) implements Packet<ClientGamePacketListener> {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final int MAX_DECORATION_NAME_LENGTH = 32;
+    private static final int MAX_DECORATION_NAME_COMPONENTS = 64;
+    private static final AtomicLong NEXT_DECORATION_WARNING_NANOS = new AtomicLong();
     public static final StreamCodec<RegistryFriendlyByteBuf, ClientboundMapItemDataPacket> STREAM_CODEC = StreamCodec.composite(
         MapId.STREAM_CODEC,
         ClientboundMapItemDataPacket::mapId,
@@ -30,6 +45,76 @@ public record ClientboundMapItemDataPacket(
         ClientboundMapItemDataPacket::new
     );
 
+    // Scissors start - enforce the map decoration limit at the final client boundary too
+    public ClientboundMapItemDataPacket {
+        decorations = decorations.map(ClientboundMapItemDataPacket::sanitizeDecorations);
+    }
+
+    private static List<MapDecoration> sanitizeDecorations(final List<MapDecoration> decorations) {
+        int retainedDecorations = Math.min(decorations.size(), MapDecorations.MAX_DECORATIONS);
+        int strippedNames = 0;
+        List<MapDecoration> sanitized = new ArrayList<>(retainedDecorations);
+        for (int i = 0; i < retainedDecorations; i++) {
+            MapDecoration decoration = decorations.get(i);
+            if (decoration.name().filter(name -> !isSafeDecorationName(name)).isPresent()) {
+                decoration = new MapDecoration(decoration.type(), decoration.x(), decoration.y(), decoration.rot(), Optional.empty());
+                strippedNames++;
+            }
+            sanitized.add(decoration);
+        }
+
+        int excessDecorations = decorations.size() - retainedDecorations;
+        if (excessDecorations > 0 || strippedNames > 0) {
+            long now = System.nanoTime();
+            long nextWarning = NEXT_DECORATION_WARNING_NANOS.get();
+            if (now >= nextWarning && NEXT_DECORATION_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10))) {
+                LOGGER.warn(
+                    "Sanitized outgoing map decorations: discarded {} excess entries and stripped {} unsafe names "
+                        + "(maximum {} visible characters and {} component nodes; interactive or unsupported contents are refused)",
+                    excessDecorations,
+                    strippedNames,
+                    MAX_DECORATION_NAME_LENGTH,
+                    MAX_DECORATION_NAME_COMPONENTS
+                );
+            }
+        }
+        return List.copyOf(sanitized);
+    }
+
+    private static boolean isSafeDecorationName(final Component name) {
+        if (name.getString(MAX_DECORATION_NAME_LENGTH + 1).length() > MAX_DECORATION_NAME_LENGTH) {
+            return false;
+        }
+
+        ArrayDeque<Component> pending = new ArrayDeque<>();
+        int visited = 0;
+        pending.add(name);
+        while (!pending.isEmpty()) {
+            Component component = pending.removeLast();
+            if (++visited > MAX_DECORATION_NAME_COMPONENTS) {
+                return false;
+            }
+            if (component.getStyle().getClickEvent() != null
+                || component.getStyle().getHoverEvent() != null
+                || component.getStyle().getInsertion() != null) {
+                return false;
+            }
+
+            pending.addAll(component.getSiblings());
+            if (component.getContents() instanceof TranslatableContents translatable) {
+                for (Object argument : translatable.getArgs()) {
+                    if (argument instanceof Component argumentComponent) {
+                        pending.add(argumentComponent);
+                    }
+                }
+            } else if (!(component.getContents() instanceof PlainTextContents) && !(component.getContents() instanceof KeybindContents)) {
+                return false;
+            }
+        }
+        return true;
+    }
+    // Scissors end - enforce the map decoration limit at the final client boundary too
+
     public ClientboundMapItemDataPacket(
         final MapId mapId,
         final byte scale,
