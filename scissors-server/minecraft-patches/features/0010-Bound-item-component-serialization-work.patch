     private static DataResult<?> validateComponents(final DataComponentGetter components) {
         if (components.get(DataComponents.MAX_DAMAGE) != null && components.getOrDefault(DataComponents.MAX_STACK_SIZE, 1) > 1) {
             return DataResult.error(() -> "Item cannot be both damageable and stackable");
