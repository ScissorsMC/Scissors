+    // Scissors start - eliminate oversized item components at every serialization boundary
+    private static <T> T sanitizeSerializedComponents(final DynamicOps<T> ops, final T input, final String source) {
+        Optional<MapLike<T>> mapResult = ops.getMap(input).result();
+        if (mapResult.isEmpty()) {
+            return input;
+        }
+
+        int maximumEntries = Math.max(1, BuiltInRegistries.DATA_COMPONENT_TYPE.size());
+        java.util.List<Pair<T, T>> entries = mapResult.get().entries().limit((long)maximumEntries + 1).toList();
+        if (entries.size() > maximumEntries) {
+            warnOversized(null, source, "component count exceeds " + maximumEntries);
+            return ops.emptyMap();
+        }
+
+        T result = input;
+        long patchNodes = 0;
+        long patchStringChars = 0;
+        for (Pair<T, T> entry : entries) {
+            Optional<String> keyResult = ops.getStringValue(entry.getFirst()).result();
+            if (keyResult.isEmpty() || keyResult.get().startsWith(REMOVED_PREFIX)) {
+                continue;
+            }
+
+            final io.papermc.paper.util.CountingOps.Value complexity;
+            try {
+                complexity = ops.convertTo(COMPONENT_COUNTING_OPS, entry.getSecond());
+            } catch (final DecoderException | ArithmeticException exception) {
+                result = ops.remove(result, keyResult.get());
+                warnOversized(componentType(keyResult.get()), source, exception.getMessage());
+                continue;
+            }
+
+            long nextPatchNodes = patchNodes + complexity.nodes();
+            long nextPatchStringChars = patchStringChars + complexity.stringChars();
+            if (nextPatchNodes > MAX_PATCH_NODES || nextPatchStringChars > MAX_COMPONENT_STRING_CHARS) {
+                result = ops.remove(result, keyResult.get());
+                warnOversized(componentType(keyResult.get()), source, "total item component budget exceeded");
+            } else {
+                patchNodes = nextPatchNodes;
+                patchStringChars = nextPatchStringChars;
+            }
+        }
+        return result;
+    }
+
+    private DataComponentPatch sanitizeOversized(final DynamicOps<?> contextOps, final String source) {
+        if (this.map.isEmpty()) {
+            return this;
+        }
+
+        Reference2ObjectMap<DataComponentType<?>, Object> sanitized = new Reference2ObjectArrayMap<>(this.map.size());
+        long patchNodes = 0;
+        long patchStringChars = 0;
+        boolean changed = false;
+        for (Entry<DataComponentType<?>, Object> entry : Reference2ObjectMaps.fastIterable(this.map)) {
+            Object value = entry.getValue();
+            if (Removed.isRemoved(value)) {
+                sanitized.put(entry.getKey(), value);
+                continue;
+            }
+            if (entry.getKey().isTransient()) {
+                sanitized.put(entry.getKey(), value);
+                continue;
+            }
+            // A debug stick legitimately accumulates one selected property per block type. Its codec restricts both
+            // keys and values to registered blocks and their real properties, so registry size already bounds it.
+            // Applying the generic structural budget would erase vanilla-generated state when creative inventory
+            // synchronization sends a sufficiently used stick back to the server.
+            if (entry.getKey() == DataComponents.DEBUG_STICK_STATE) {
+                sanitized.put(entry.getKey(), value);
+                continue;
+            }
+
+            final io.papermc.paper.util.CountingOps.Value complexity;
+            try {
+                complexity = encodeComplexity(contextOps, entry.getKey(), value);
+            } catch (final DecoderException | ArithmeticException exception) {
+                changed = true;
+                warnOversized(entry.getKey(), source, exception.getMessage());
+                continue;
+            }
+
+            if (complexity == null) {
+                // Leave unrelated codec errors to the real encoder so they are not mistaken for exploit sanitation.
+                sanitized.put(entry.getKey(), value);
+                continue;
+            }
+
+            long nextPatchNodes = patchNodes + complexity.nodes();
+            long nextPatchStringChars = patchStringChars + complexity.stringChars();
+            if (nextPatchNodes > MAX_PATCH_NODES || nextPatchStringChars > MAX_COMPONENT_STRING_CHARS) {
+                changed = true;
+                warnOversized(entry.getKey(), source, "total item component budget exceeded");
+                continue;
+            }
+            patchNodes = nextPatchNodes;
+            patchStringChars = nextPatchStringChars;
+            sanitized.put(entry.getKey(), value);
+        }
+        return changed ? (sanitized.isEmpty() ? EMPTY : new DataComponentPatch(sanitized)) : this;
+    }
+
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    private static io.papermc.paper.util.CountingOps.@Nullable Value encodeComplexity(
+        final DynamicOps<?> contextOps, final DataComponentType<?> type, final Object value
+    ) {
+        DynamicOps<io.papermc.paper.util.CountingOps.Value> countingOps = contextOps instanceof RegistryOps<?> registryOps
+            ? ((RegistryOps)registryOps).withParent(COMPONENT_COUNTING_OPS)
+            : COMPONENT_COUNTING_OPS;
+        DataResult<io.papermc.paper.util.CountingOps.Value> encoded = ((Codec)type.codecOrThrow()).encodeStart(countingOps, value);
+        return encoded.result().orElse(null);
+    }
+
+    private static int maxUntrustedNetworkBytes(final DataComponentType<?> type) {
+        Identifier id = BuiltInRegistries.DATA_COMPONENT_TYPE.getKey(type);
+        if (type == DataComponents.DEBUG_STICK_STATE || id != null && (id.getPath().equals("written_book_content") || id.getPath().equals("writable_book_content"))) {
+            return MAX_UNTRUSTED_BOOK_COMPONENT_BYTES;
+        }
+        return MAX_UNTRUSTED_COMPONENT_BYTES;
+    }
+
+    private static @Nullable DataComponentType<?> componentType(final String key) {
+        String normalized = key.startsWith(REMOVED_PREFIX) ? key.substring(REMOVED_PREFIX.length()) : key;
+        Identifier id = Identifier.tryParse(normalized);
+        return id == null ? null : BuiltInRegistries.DATA_COMPONENT_TYPE.getValue(id);
+    }
+
+    private static void warnOversized(final @Nullable DataComponentType<?> type, final String source, final @Nullable String reason) {
+        long now = System.nanoTime();
+        long next = NEXT_OVERSIZED_WARNING_NANOS.get();
+        if (now < next || !NEXT_OVERSIZED_WARNING_NANOS.compareAndSet(next, now + TimeUnit.SECONDS.toNanos(1))) {
+            return;
+        }
+
+        Identifier id = type == null ? null : BuiltInRegistries.DATA_COMPONENT_TYPE.getKey(type);
+        LOGGER.warn(
+            "Discarded oversized item component {} during {}: {} (limits: {} nodes/component, {} nodes/item, depth {}, {} string characters)",
+            id == null ? "<unknown>" : id,
+            source,
+            reason == null ? "complexity limit exceeded" : reason,
+            MAX_COMPONENT_NODES,
+            MAX_PATCH_NODES,
+            MAX_COMPONENT_DEPTH,
+            MAX_COMPONENT_STRING_CHARS
+        );
+    }
+    // Scissors end - eliminate oversized item components at every serialization boundary
+
+    private final boolean sanitizedDuringDecode;
+
     DataComponentPatch(final Reference2ObjectMap<DataComponentType<?>, Object> map) {
+        this(map, false);
+    }
+
+    private DataComponentPatch(final Reference2ObjectMap<DataComponentType<?>, Object> map, final boolean sanitizedDuringDecode) {
         this.map = map;
+        this.sanitizedDuringDecode = sanitizedDuringDecode;
+    }
+
+    private DataComponentPatch markSanitizedDuringDecode() {
+        return this.sanitizedDuringDecode ? this : new DataComponentPatch(this.map, true);
+    }
+
+    public boolean wasSanitizedDuringDecode() {
+        return this.sanitizedDuringDecode;
     }
 
