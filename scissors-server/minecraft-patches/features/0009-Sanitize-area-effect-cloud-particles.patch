         this.reapplicationDelay = input.getIntOr("ReapplicationDelay", 20);
         this.durationOnUse = input.getIntOr("DurationOnUse", 0);
         this.radiusOnUse = input.getFloatOr("RadiusOnUse", 0.0F);
@@ -365,6 +446,23 @@ public class AreaEffectCloud extends Entity implements TraceableEntity {
 
     @Override
     public void onSyncedDataUpdated(final EntityDataAccessor<?> accessor) {
+        // Scissors start - keep the invariant even if trusted NMS code writes the data watcher directly
+        if (!this.level().isClientSide()) {
+            if (DATA_RADIUS.equals(accessor)) {
+                float radius = this.getRadius();
+                if (Float.compare(radius, sanitizeRadius(radius)) != 0) {
+                    this.setRadius(radius);
+                    return;
+                }
+            } else if (DATA_PARTICLE.equals(accessor)) {
+                ParticleOptions particle = this.getParticle();
+                if (!isParticleSafeForCloud(particle)) {
+                    this.setCustomParticle(particle);
+                    return;
+                }
+            }
+        }
+        // Scissors end - keep the invariant even if trusted NMS code writes the data watcher directly
         if (DATA_RADIUS.equals(accessor)) {
             this.refreshDimensions();
         }
