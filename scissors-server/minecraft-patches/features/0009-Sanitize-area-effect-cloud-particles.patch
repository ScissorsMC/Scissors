@@ -99,10 +115,66 @@ public class AreaEffectCloud extends Entity implements TraceableEntity {
     }
 
     public void setCustomParticle(final @Nullable ParticleOptions customParticle) {
-        this.customParticle = customParticle;
+        // Scissors start - only allow the two particle implementations vanilla deliberately uses for clouds
+        ParticleOptions sanitizedParticle = customParticle;
+        if (!isParticleSafeForCloud(customParticle)) {
+            sanitizedParticle = null;
+            if (!this.level().isClientSide()) {
+                long now = System.nanoTime();
+                long nextWarning = NEXT_UNSAFE_DATA_WARNING_NANOS.get();
+                if (now >= nextWarning
+                    && NEXT_UNSAFE_DATA_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10L))) {
+                    LOGGER.warn(
+                        "Discarded unsafe area effect cloud particle {} at {}; arbitrary particle implementations cannot be amplified by clouds",
+                        BuiltInRegistries.PARTICLE_TYPE.getKey(customParticle.getType()),
+                        this.blockPosition().toShortString()
+                    );
+                }
+            }
+        }
+        this.customParticle = sanitizedParticle;
         this.updateParticle();
     }
 
+    // The client constructs every requested particle before applying its queue limits. An allowlist is required:
+    // properties such as ParticleType#overrideLimiter do not describe provider construction or emitter fan-out cost.
+    public static boolean isParticleSafeForCloud(final @Nullable ParticleOptions particle) {
+        if (particle == null || particle instanceof ColorParticleOption && particle.getType() == ParticleTypes.ENTITY_EFFECT) {
+            return true;
+        }
+        return particle instanceof PowerParticleOption power
+            && particle.getType() == ParticleTypes.DRAGON_BREATH
+            && Float.compare(power.getPower(), 1.0F) == 0;
+    }
+
+    public static float sanitizeRadius(final float radius) {
+        return Float.isFinite(radius) ? Mth.clamp(radius, 0.0F, SCISSORS_MAX_SAFE_RADIUS) : DEFAULT_RADIUS;
+    }
+
+    public static int sanitizeDuration(final int duration) {
+        if (duration == INFINITE_DURATION) {
+            return SCISSORS_MAX_SAFE_DURATION;
+        }
+        return Mth.clamp(duration, 0, SCISSORS_MAX_SAFE_DURATION);
+    }
+
+    public static int sanitizeWaitTime(final int waitTime) {
+        return Mth.clamp(waitTime, 0, SCISSORS_MAX_SAFE_WAIT_TIME);
+    }
+
+    public static int sanitizeAge(final int age) {
+        return Mth.clamp(age, 0, SCISSORS_MAX_SAFE_AGE);
+    }
+
+    private void warnUnsafeData(final String field, final Object original, final Object replacement) {
+        long now = System.nanoTime();
+        long nextWarning = NEXT_UNSAFE_DATA_WARNING_NANOS.get();
+        if (now >= nextWarning && NEXT_UNSAFE_DATA_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10L))) {
+            LOGGER.warn("Sanitized unsafe area effect cloud {} from {} to {} at {}", field, original, replacement, this.blockPosition().toShortString());
+        }
+    }
+    // Scissors end - bound the particle work generated by an area effect cloud
+
     public void setPotionDurationScale(final float scale) {
         this.potionDurationScale = scale;
     }
@@ -137,14 +209,18 @@ public class AreaEffectCloud extends Entity implements TraceableEntity {
     }
 
     public void setDuration(final int duration) {
-        this.duration = duration;
+        int sanitizedDuration = sanitizeDuration(duration);
+        if (duration != sanitizedDuration && !this.level().isClientSide()) {
+            this.warnUnsafeData("duration", duration, sanitizedDuration);
+        }
+        this.duration = sanitizedDuration;
     }
 
     // Paper start - EAR 2
     @Override
     public void inactiveTick() {
         super.inactiveTick();
-        if (this.duration != INFINITE_DURATION && this.tickCount - this.waitTime >= this.duration) {
