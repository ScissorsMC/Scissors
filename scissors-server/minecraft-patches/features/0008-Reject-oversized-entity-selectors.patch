+    // Scissors start - defense in depth for selectors created outside EntitySelectorOptions
+    private static MinMaxBounds.@Nullable Doubles sanitizeRange(final MinMaxBounds.@Nullable Doubles range) {
+        if (range == null) {
+            return null;
+        }
+
+        Optional<Double> min = range.min().map(value -> sanitizeRangeValue(value, 0.0, MAX_RANGE));
+        Optional<Double> max = range.max().map(value -> sanitizeRangeValue(value, 0.0, MAX_RANGE));
+        if (min.isPresent()) {
+            return max.isPresent() ? MinMaxBounds.Doubles.between(min.get(), max.get()) : MinMaxBounds.Doubles.atLeast(min.get());
+        }
+        return max.isPresent() ? MinMaxBounds.Doubles.atMost(max.get()) : MinMaxBounds.Doubles.ANY;
+    }
+
+    private static @Nullable AABB sanitizeAabb(final @Nullable AABB aabb) {
+        if (aabb == null) {
+            return null;
+        }
+
+        double minX = sanitizeRangeValue(aabb.minX, -MAX_RANGE, MAX_RANGE + 1.0);
+        double minY = sanitizeRangeValue(aabb.minY, -MAX_RANGE, MAX_RANGE + 1.0);
+        double minZ = sanitizeRangeValue(aabb.minZ, -MAX_RANGE, MAX_RANGE + 1.0);
+        double maxX = sanitizeRangeValue(aabb.maxX, -MAX_RANGE, MAX_RANGE + 1.0);
+        double maxY = sanitizeRangeValue(aabb.maxY, -MAX_RANGE, MAX_RANGE + 1.0);
+        double maxZ = sanitizeRangeValue(aabb.maxZ, -MAX_RANGE, MAX_RANGE + 1.0);
+        return new AABB(
+            Math.min(minX, maxX),
+            Math.min(minY, maxY),
+            Math.min(minZ, maxZ),
+            Math.max(minX, maxX),
+            Math.max(minY, maxY),
+            Math.max(minZ, maxZ)
+        );
+    }
+
+    private static double sanitizeRangeValue(final double value, final double min, final double max) {
+        return Double.isNaN(value) ? 0.0 : net.minecraft.util.Mth.clamp(value, min, max);
+    }
+    // Scissors end - defense in depth for selectors created outside EntitySelectorOptions
+
