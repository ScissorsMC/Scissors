+    // Scissors - reject non-finite positions from selectors constructed outside the command parser too
+    private Vec3 getPosition(final CommandSourceStack sender) throws CommandSyntaxException {
+        Vec3 pos = this.position.apply(sender.getPosition());
+        if (!pos.isFinite()) {
+            long now = Util.getMillis();
+            long nextWarning = NEXT_INVALID_POSITION_WARNING.get();
+            if (now >= nextWarning && NEXT_INVALID_POSITION_WARNING.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toMillis(1L))) {
+                LOGGER.warn("Discarded an entity selector that produced non-finite position {}", pos);
+            }
+            throw ERROR_NON_FINITE_POSITION.create();
+        }
+        return pos;
+    }
+
