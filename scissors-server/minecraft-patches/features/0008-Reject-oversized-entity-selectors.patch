From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telesphoreo <me@telesphoreo.me>
Date: Wed, 29 Jul 2026 00:59:24 -0400
Subject: [PATCH] Reject oversized entity selectors

Reject command selector distance and volume bounds beyond 1024 blocks before they can trigger enormous entity queries. Sanitize selectors constructed outside the command parser as defense in depth and log eliminated oversized ranges.

diff --git a/net/minecraft/commands/arguments/selector/EntitySelector.java b/net/minecraft/commands/arguments/selector/EntitySelector.java
index 6c05b9276bdc267a36376f6c64592a50e4b2b36e..293cfcfa6b0b1803eaece85987a4444c6a059fc9 100644
--- a/net/minecraft/commands/arguments/selector/EntitySelector.java
+++ b/net/minecraft/commands/arguments/selector/EntitySelector.java
@@ -2,9 +2,11 @@ package net.minecraft.commands.arguments.selector;
 
 import com.mojang.brigadier.StringReader;
 import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import com.mojang.logging.LogUtils;
 import com.mojang.serialization.Codec;
 import it.unimi.dsi.fastutil.objects.ObjectArrayList;
 import java.util.List;
+import java.util.Optional;
 import java.util.UUID;
 import java.util.function.BiConsumer;
 import java.util.function.Function;
@@ -26,8 +28,11 @@ import net.minecraft.world.level.entity.EntityTypeTest;
 import net.minecraft.world.phys.AABB;
 import net.minecraft.world.phys.Vec3;
 import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
 
 public class EntitySelector {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    public static final double MAX_RANGE = 1024.0;
     public static final int INFINITE = Integer.MAX_VALUE;
     public static final BiConsumer<Vec3, List<? extends Entity>> ORDER_ARBITRARY = (p, c) -> {};
     private static final EntityTypeTest<Entity, ?> ANY_TYPE = new EntityTypeTest<Entity, Entity>() {
@@ -87,9 +92,14 @@ public class EntitySelector {
         this.includesEntities = includesEntities;
         this.worldLimited = worldLimited;
         this.contextFreePredicates = contextFreePredicates;
-        this.range = range;
+        // Scissors start - keep direct/programmatic selector construction inside the same safe bounds as command parsing
+        this.range = sanitizeRange(range);
         this.position = position;
-        this.aabb = aabb;
+        this.aabb = sanitizeAabb(aabb);
+        if (!java.util.Objects.equals(range, this.range) || !java.util.Objects.equals(aabb, this.aabb)) {
+            LOGGER.warn("Sanitized an entity selector whose range exceeded {} blocks", MAX_RANGE);
+        }
+        // Scissors end - keep direct/programmatic selector construction inside the same safe bounds as command parsing
         this.order = order;
         this.currentEntity = currentEntity;
         this.playerName = playerName;
@@ -98,6 +108,46 @@ public class EntitySelector {
         this.usesSelector = usesSelector;
     }
 
+    // Scissors start - defense in depth for selectors created outside EntitySelectorOptions
+    private static MinMaxBounds.@Nullable Doubles sanitizeRange(final MinMaxBounds.@Nullable Doubles range) {
+        if (range == null) {
+            return null;
+        }
+
+        Optional<Double> min = range.min().map(value -> sanitizeRangeValue(value, 0.0, MAX_RANGE));
+        Optional<Double> max = range.max().map(value -> sanitizeRangeValue(value, 0.0, MAX_RANGE));
+        if (min.isPresent()) {
+            return max.isPresent() ? MinMaxBounds.Doubles.between(min.get(), max.get()) : MinMaxBounds.Doubles.atLeast(min.get());
+        }
+        return max.isPresent() ? MinMaxBounds.Doubles.atMost(max.get()) : MinMaxBounds.Doubles.ANY;
+    }
+
+    private static @Nullable AABB sanitizeAabb(final @Nullable AABB aabb) {
+        if (aabb == null) {
+            return null;
+        }
+
+        double minX = sanitizeRangeValue(aabb.minX, -MAX_RANGE, MAX_RANGE + 1.0);
+        double minY = sanitizeRangeValue(aabb.minY, -MAX_RANGE, MAX_RANGE + 1.0);
+        double minZ = sanitizeRangeValue(aabb.minZ, -MAX_RANGE, MAX_RANGE + 1.0);
+        double maxX = sanitizeRangeValue(aabb.maxX, -MAX_RANGE, MAX_RANGE + 1.0);
+        double maxY = sanitizeRangeValue(aabb.maxY, -MAX_RANGE, MAX_RANGE + 1.0);
+        double maxZ = sanitizeRangeValue(aabb.maxZ, -MAX_RANGE, MAX_RANGE + 1.0);
+        return new AABB(
+            Math.min(minX, maxX),
+            Math.min(minY, maxY),
+            Math.min(minZ, maxZ),
+            Math.max(minX, maxX),
+            Math.max(minY, maxY),
+            Math.max(minZ, maxZ)
+        );
+    }
+
+    private static double sanitizeRangeValue(final double value, final double min, final double max) {
+        return Double.isNaN(value) ? 0.0 : net.minecraft.util.Mth.clamp(value, min, max);
+    }
+    // Scissors end - defense in depth for selectors created outside EntitySelectorOptions
+
     public int getMaxResults() {
         return this.maxResults;
     }
diff --git a/net/minecraft/commands/arguments/selector/options/EntitySelectorOptions.java b/net/minecraft/commands/arguments/selector/options/EntitySelectorOptions.java
