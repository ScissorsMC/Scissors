+    // Scissors start - reject crash-sized selector volumes instead of silently clamping user commands
+    private static boolean isValidRange(final Optional<Double> value) {
+        return value.isEmpty() || Double.isFinite(value.get()) && Math.abs(value.get()) <= EntitySelector.MAX_RANGE;
+    }
+
+    private static double readLimitedDelta(final EntitySelectorParser parser, final int start) throws CommandSyntaxException {
+        double value = parser.getReader().readDouble();
+        if (!Double.isFinite(value) || Math.abs(value) > EntitySelector.MAX_RANGE) {
+            logRejectedRange();
+            throw rollbackAndThrow(parser, start, ERROR_RANGE_TOO_LARGE);
+        }
+        return value;
+    }
+
+    private static double readFiniteCoordinate(final EntitySelectorParser parser, final int start) throws CommandSyntaxException {
+        double value = parser.getReader().readDouble();
+        if (!Double.isFinite(value)) {
+            logRejectedRange();
+            throw rollbackAndThrow(parser, start, EntitySelector.ERROR_NON_FINITE_POSITION);
+        }
+        return value;
+    }
+
+    private static void logRejectedRange() {
+        long now = Util.getMillis();
+        long nextWarning = NEXT_RANGE_WARNING.get();
+        if (now >= nextWarning && NEXT_RANGE_WARNING.compareAndSet(nextWarning, now + RANGE_WARNING_INTERVAL)) {
+            LOGGER.warn("Discarded an entity selector with non-finite coordinates or a distance/volume beyond {} blocks", (int)EntitySelector.MAX_RANGE);
+        }
+    }
+    // Scissors end - reject crash-sized selector volumes instead of silently clamping user commands
+
     private static CommandSyntaxException rollbackAndThrow(
         final EntitySelectorParser parser, final int start, final DynamicCommandExceptionType type, final String argument
     ) {
