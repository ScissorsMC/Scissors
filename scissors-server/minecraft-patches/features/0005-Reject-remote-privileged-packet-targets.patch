 public class ServerboundJigsawGeneratePacket implements Packet<ServerGamePacketListener> {
     public static final StreamCodec<FriendlyByteBuf, ServerboundJigsawGeneratePacket> STREAM_CODEC = Packet.codec(
@@ -50,6 +51,11 @@ public class ServerboundJigsawGeneratePacket implements Packet<ServerGamePacketL
         return this.levels;
     }
 
+    // Scissors - reject packet depths outside the same range as jigsaw structures and /place jigsaw
+    public boolean hasValidLevels() {
+        return this.levels >= JigsawStructure.MIN_DEPTH && this.levels <= JigsawStructure.MAX_DEPTH;
+    }
+
     public boolean keepJigsaws() {
         return this.keepJigsaws;
     }
