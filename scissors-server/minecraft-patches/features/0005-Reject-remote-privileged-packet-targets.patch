+    // Scissors start - discard remote privileged packet targets before any path can load or operate on their chunks
+    private boolean isValidPrivilegedBlockTarget(final BlockPos pos, final String action) {
+        ServerLevel level = this.player.level();
+        boolean valid = level.isLoadedAndInBounds(pos)
+            && this.player.position().distanceToSqr(Vec3.atCenterOf(pos)) <= MAX_PRIVILEGED_PACKET_DISTANCE_SQUARED;
+        if (!valid) {
+            this.logInvalidPrivilegedPacket(action, pos.toShortString());
+        }
+        return valid;
+    }
+
+    private boolean isValidPrivilegedEntityTarget(final Entity entity, final String action) {
+        boolean valid = entity.level() == this.player.level()
+            && this.player.position().distanceToSqr(entity.position()) <= MAX_PRIVILEGED_PACKET_DISTANCE_SQUARED;
+        if (!valid) {
+            this.logInvalidPrivilegedPacket(action, entity.getType() + " " + entity.getUUID());
+        }
+        return valid;
+    }
+
+    private void logInvalidPrivilegedPacket(final String action, final String target) {
+        long now = Util.getMillis();
+        if (now - this.lastInvalidPrivilegedPacketWarning >= INVALID_PRIVILEGED_PACKET_LOG_INTERVAL) {
+            this.lastInvalidPrivilegedPacketWarning = now;
+            LOGGER.warn(
+                "Discarding remote {} packet from {} targeting {}; target must be loaded and within 32 blocks",
+                action,
+                this.player.getScoreboardName(),
+                target
+            );
+        }
+    }
+    // Scissors end - discard remote privileged packet targets before any path can load or operate on their chunks
+
