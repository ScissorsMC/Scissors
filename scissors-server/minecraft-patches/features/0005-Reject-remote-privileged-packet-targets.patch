@@ -73,10 +77,37 @@ public class TestInstanceBlockEntity extends BlockEntity implements BoundingBoxR
     }
 
     public void set(final TestInstanceBlockEntity.Data data) {
-        this.data = data;
+        Vec3i size = data.size();
+        Vec3i sanitizedSize = new Vec3i(
+            Mth.clamp(size.getX(), 0, StructureBlockEntity.MAX_SIZE_PER_AXIS),
+            Mth.clamp(size.getY(), 0, StructureBlockEntity.MAX_SIZE_PER_AXIS),
+            Mth.clamp(size.getZ(), 0, StructureBlockEntity.MAX_SIZE_PER_AXIS)
+        );
+        if (!sanitizedSize.equals(size)) {
+            long now = System.nanoTime();
+            long nextWarning = NEXT_INVALID_SIZE_WARNING_NANOS.get();
+            if (now >= nextWarning
+                && NEXT_INVALID_SIZE_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10))) {
+                LOGGER.warn(
+                    "Sanitized invalid test instance size {} at {}; each axis must be between 0 and {}",
+                    size,
+                    this.getBlockPos().toShortString(),
+                    StructureBlockEntity.MAX_SIZE_PER_AXIS
+                );
+            }
+            this.data = data.withSize(sanitizedSize);
+        } else {
+            this.data = data;
+        }
         this.setChanged();
     }
 
+    public static boolean isValidSize(final Vec3i size) {
+        return size.getX() >= 0 && size.getX() <= StructureBlockEntity.MAX_SIZE_PER_AXIS
+            && size.getY() >= 0 && size.getY() <= StructureBlockEntity.MAX_SIZE_PER_AXIS
+            && size.getZ() >= 0 && size.getZ() <= StructureBlockEntity.MAX_SIZE_PER_AXIS;
+    }
+
     public static Optional<Vec3i> getStructureSize(final ServerLevel level, final ResourceKey<GameTestInstance> testKey) {
         return getStructureTemplate(level, testKey).map(StructureTemplate::getSize);
     }
