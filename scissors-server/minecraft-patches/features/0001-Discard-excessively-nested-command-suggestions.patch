From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Telesphoreo <me@telesphoreo.me>
Date: Tue, 28 Jul 2026 00:23:45 -0400
Subject: [PATCH] Discard excessively nested command suggestions

Reject recursive command input before it enters the async suggestion queue, and make the authoritative SNBT depth guard report invalid syntax instead of leaking a runtime exception. This prevents completion floods from spamming errors or exhausting the parser stack.

diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 612391a857bbc30fee7a46a6e62ab71e946c2f9e..0aeb2f7b5beb0e3c42bb33e9cd6c3aa96515ba38 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -272,6 +272,7 @@ public class ServerGamePacketListenerImpl
     private static final Component CHAT_VALIDATION_FAILED = Component.translatable("multiplayer.disconnect.chat_validation_failed");
     private static final Component INVALID_COMMAND_SIGNATURE = Component.translatable("chat.disabled.invalid_command_signature").withStyle(ChatFormatting.RED);
     private static final long UNSAFE_CREATIVE_ITEM_LOG_INTERVAL = TimeUnit.SECONDS.toMillis(1L); // Scissors - rate-limit exploit logging
+    private static final long NESTED_COMMAND_SUGGESTION_LOG_INTERVAL = TimeUnit.SECONDS.toMillis(1L); // Scissors - rate-limit exploit logging
     public ServerPlayer player;
     public final PlayerChunkSender chunkSender;
     private int tickCount;
@@ -282,6 +283,7 @@ public class ServerGamePacketListenerImpl
     private final TickThrottler tabSpamThrottler = new TickThrottler(io.papermc.paper.configuration.GlobalConfiguration.get().spamLimiter.tabSpamIncrement, io.papermc.paper.configuration.GlobalConfiguration.get().spamLimiter.tabSpamLimit); // Paper - configurable tab spam limits
     private final TickThrottler recipeSpamPackets = new TickThrottler(io.papermc.paper.configuration.GlobalConfiguration.get().spamLimiter.recipeSpamIncrement, io.papermc.paper.configuration.GlobalConfiguration.get().spamLimiter.recipeSpamLimit);
     private long lastUnsafeCreativeItemWarning; // Scissors - rate-limit exploit logging
+    private long lastNestedCommandSuggestionWarning; // Scissors - rate-limit exploit logging
     private double firstGoodX;
     private double firstGoodY;
     private double firstGoodZ;
@@ -863,6 +865,20 @@ public class ServerGamePacketListenerImpl
 
     @Override
     public void handleCustomCommandSuggestions(final ServerboundCommandSuggestionPacket packet) {
+        // Scissors start - discard recursive parser crash payloads before they reach the async queue
+        if (io.github.scissorsmc.util.CommandNesting.exceedsMaxDepth(packet.command())) {
+            final long now = Util.getMillis();
+            if (now - this.lastNestedCommandSuggestionWarning >= NESTED_COMMAND_SUGGESTION_LOG_INTERVAL) {
+                this.lastNestedCommandSuggestionWarning = now;
+                LOGGER.warn(
+                    "Discarding excessively nested command suggestion from {} (maximum depth: {})",
+                    this.player.getScoreboardName(),
+                    io.github.scissorsmc.util.CommandNesting.MAX_DEPTH
+                );
+            }
+            return;
+        }
+        // Scissors end - discard recursive parser crash payloads before they reach the async queue
         // Paper start - throttle tab completions
         if (!this.tabSpamThrottler.isIncrementAndUnderThreshold() && !this.server.getPlayerList().isOp(this.player.nameAndId()) && !this.server.isSingleplayerOwner(this.player.nameAndId())) {
             this.disconnectAsync(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM);
diff --git a/net/minecraft/util/parsing/packrat/Scope.java b/net/minecraft/util/parsing/packrat/Scope.java
index 7fe7f5974026a6b883437425fa2af0ee06c2e85c..3a12c9d6b878246cb5124eb00f6b117e75e9b6ba 100644
--- a/net/minecraft/util/parsing/packrat/Scope.java
+++ b/net/minecraft/util/parsing/packrat/Scope.java
@@ -270,7 +270,8 @@ public final class Scope {
     private int depth;
 
     private static final Term<?> INCREASING_DEPTH_TERM = (parseState, scope, control) -> {
-        if (++scope.depth > 512) {
+        // Scissors - stop before recursive SNBT parsing can exhaust the stack
+        if (++scope.depth > io.github.scissorsmc.util.CommandNesting.MAX_DEPTH) {
             parseState.errorCollector().store(parseState.mark(), new io.papermc.paper.brigadier.TagParseCommandSyntaxException("Too deep"));
             return false;
         }
