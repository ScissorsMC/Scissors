+
+    // Scissors start - share one breadth budget across recursively-created pretty printers
+    private static final class ElementBudget {
+        private final int maxDepth;
+        private int remaining;
+
+        private ElementBudget(final int maxDepth, final int remaining) {
+            this.maxDepth = maxDepth;
+            this.remaining = remaining;
+        }
+
+        private static ElementBudget bounded() {
+            return new ElementBudget(MAX_DEPTH, MAX_VISITED_ELEMENTS);
+        }
+
+        private static ElementBudget unbounded() {
+            return new ElementBudget(Integer.MAX_VALUE, Integer.MAX_VALUE);
+        }
+
+        private boolean consume() {
+            if (this.remaining <= 0) {
+                this.logTruncation();
+                return false;
+            }
+            this.remaining--;
+            return true;
+        }
+
+        private boolean hasRemaining() {
+            return this.remaining > 0;
+        }
+
+        private int remaining() {
+            return this.remaining;
+        }
+
+        private int maxDepth() {
+            return this.maxDepth;
+        }
+
+        private void logTruncation() {
+            if (this.maxDepth == Integer.MAX_VALUE) {
+                return;
+            }
+            long now = System.nanoTime();
+            long nextWarning = NEXT_TRUNCATION_WARNING_NANOS.get();
+            if (now >= nextWarning && NEXT_TRUNCATION_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10))) {
+                LOGGER.warn("Truncated bounded pretty SNBT rendering after {} elements or {} levels", MAX_VISITED_ELEMENTS, MAX_DEPTH);
+            }
+        }
+    }
+    // Scissors end - share one breadth budget across recursively-created pretty printers
 }
