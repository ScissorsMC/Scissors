+    // Returns a sanitized copy with invalid entries dropped, or null when every entry is already safe.
+    private static @Nullable List<ItemStackTemplate> filterValidNestedItems(final List<ItemStackTemplate> items) {
+        List<ItemStackTemplate> valid = null;
+        for (int i = 0; i < items.size(); i++) {
+            ItemStackTemplate item = items.get(i);
+            boolean ok = isValidNestedItem(item);
+            ItemStackTemplate sanitized = ok ? sanitizeNestedItem(item) : null;
+            if ((!ok || sanitized != item) && valid == null) {
+                valid = new java.util.ArrayList<>(items.subList(0, i));
+            }
+            if (sanitized != null && valid != null) {
+                valid.add(sanitized);
+            }
+        }
+        return valid;
+    }
+
+    private static @Nullable ItemStackTemplate sanitizeNestedItem(final ItemStackTemplate item) {
+        ItemStack created = item.create();
+        ItemStack sanitized = sanitizeUnsafeData(created);
+        return sanitized == created ? item : ItemStackTemplate.fromNonEmptyStack(sanitized);
+    }
+
+    // Returns a rebuilt container with invalid slots cleared and unsafe slots sanitized, or null when unchanged.
+    private static @Nullable ItemContainerContents filterValidContainer(final ItemContainerContents container) {
+        List<Optional<ItemStackTemplate>> slots = container.items;
+        List<ItemStack> rebuilt = null;
+        for (int i = 0; i < slots.size(); i++) {
+            Optional<ItemStackTemplate> slot = slots.get(i);
+            boolean ok = slot.isEmpty() || isValidNestedItem(slot.get());
+            ItemStack original = ok ? slot.map(ItemStackTemplate::create).orElse(ItemStack.EMPTY) : ItemStack.EMPTY;
+            ItemStack sanitized = original.isEmpty() ? original : sanitizeUnsafeData(original);
+            if ((!ok || sanitized != original) && rebuilt == null) {
+                rebuilt = new java.util.ArrayList<>();
+                for (int j = 0; j < i; j++) {
+                    rebuilt.add(slots.get(j).map(ItemStackTemplate::create).orElse(ItemStack.EMPTY));
+                }
+            }
+            if (rebuilt != null) {
+                rebuilt.add(sanitized);
+            }
+        }
+        return rebuilt == null ? null : ItemContainerContents.fromItems(rebuilt);
+    }
+    // Scissors end - eliminate unsafe item data before it reaches clients
 
