+    private static void warnUnsafeCloudItemData(final ItemStack stack) {
+        long now = System.nanoTime();
+        long nextWarning = NEXT_UNSAFE_CLOUD_ITEM_WARNING_NANOS.get();
+        if (now >= nextWarning && NEXT_UNSAFE_CLOUD_ITEM_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10L))) {
+            LOGGER.warn(
+                "Sanitized area effect cloud data on {}: only canonical entity_effect/dragon_breath particles, radius <= 7, duration <= 600, and wait time <= 20 are permitted",
+                BuiltInRegistries.ITEM.getKey(stack.getItem())
+            );
+        }
+    }
+
+    private static void warnUnsafeCloudSpawnEggData(final ItemStack stack, final net.minecraft.world.entity.EntityType<?> restoredType) {
+        long now = System.nanoTime();
+        long nextWarning = NEXT_UNSAFE_CLOUD_ITEM_WARNING_NANOS.get();
+        if (now >= nextWarning && NEXT_UNSAFE_CLOUD_ITEM_WARNING_NANOS.compareAndSet(nextWarning, now + TimeUnit.SECONDS.toNanos(10L))) {
+            LOGGER.warn(
+                "Removed area effect cloud override from {} and restored entity type {}; area effect clouds cannot be supplied through repeat-use spawn eggs",
+                BuiltInRegistries.ITEM.getKey(stack.getItem()),
+                BuiltInRegistries.ENTITY_TYPE.getKey(restoredType)
+            );
+        }
+    }
