+    private static boolean removeUnsafeAreaEffectCloudParticle(final net.minecraft.nbt.CompoundTag entityData, final String key) {
+        net.minecraft.nbt.Tag particleTag = entityData.get(key);
+        if (particleTag == null) {
+            return false;
+        }
+
+        Optional<net.minecraft.core.particles.ParticleOptions> particle = net.minecraft.core.particles.ParticleTypes.CODEC
+            .parse(net.minecraft.nbt.NbtOps.INSTANCE, particleTag)
+            .result();
+        if (particle.isEmpty() || !net.minecraft.world.entity.AreaEffectCloud.isParticleSafeForCloud(particle.get())) {
+            entityData.remove(key);
+            return true;
+        }
+        return false;
+    }
+
+    private static boolean sanitizeAreaEffectCloudRadius(final net.minecraft.nbt.CompoundTag entityData) {
+        if (!entityData.contains("Radius")) {
+            return false;
+        }
+        Optional<Float> parsedRadius = entityData.getFloat("Radius");
+        if (parsedRadius.isEmpty()) {
+            entityData.putFloat("Radius", 3.0F);
+            return true;
+        }
+        float radius = parsedRadius.get();
+        float sanitizedRadius = net.minecraft.world.entity.AreaEffectCloud.sanitizeRadius(radius);
+        if (Float.compare(radius, sanitizedRadius) == 0) {
+            return false;
+        }
+        entityData.putFloat("Radius", sanitizedRadius);
+        return true;
+    }
+
+    private static boolean sanitizeAreaEffectCloudDuration(final net.minecraft.nbt.CompoundTag entityData) {
+        if (!entityData.contains("Duration")) {
+            return false;
+        }
+        int duration = entityData.getInt("Duration").orElse(net.minecraft.world.entity.AreaEffectCloud.INFINITE_DURATION);
+        int sanitizedDuration = net.minecraft.world.entity.AreaEffectCloud.sanitizeDuration(duration);
+        if (duration == sanitizedDuration) {
+            return false;
+        }
+        entityData.putInt("Duration", sanitizedDuration);
+        return true;
+    }
+
+    private static boolean sanitizeAreaEffectCloudAge(final net.minecraft.nbt.CompoundTag entityData) {
+        if (!entityData.contains("Age")) {
+            return false;
+        }
+        Optional<Integer> parsedAge = entityData.getInt("Age");
+        int age = parsedAge.orElse(0);
+        int sanitizedAge = net.minecraft.world.entity.AreaEffectCloud.sanitizeAge(age);
+        if (parsedAge.isPresent() && age == sanitizedAge) {
+            return false;
+        }
+        entityData.putInt("Age", sanitizedAge);
+        return true;
+    }
+
+    private static boolean sanitizeAreaEffectCloudWaitTime(final net.minecraft.nbt.CompoundTag entityData) {
+        if (!entityData.contains("WaitTime")) {
+            return false;
+        }
+        Optional<Integer> parsedWaitTime = entityData.getInt("WaitTime");
+        int waitTime = parsedWaitTime.orElse(20);
+        int sanitizedWaitTime = net.minecraft.world.entity.AreaEffectCloud.sanitizeWaitTime(waitTime);
+        if (parsedWaitTime.isPresent() && waitTime == sanitizedWaitTime) {
+            return false;
+        }
+        entityData.putInt("WaitTime", sanitizedWaitTime);
+        return true;
+    }
