+    /**
+     * Eliminates every known client-dangerous item payload. This is used for storage decode, creative ingress, and
+     * the final client-bound item encoding chokepoint.
+     */
+    public static ItemStack sanitizeUnsafeData(final ItemStack itemStack) {
+        ItemStack result = sanitizeNestedItems(itemStack);
+        TypedEntityData<net.minecraft.world.entity.EntityType<?>> entityData = result.get(DataComponents.ENTITY_DATA);
+
+        // There is no vanilla area-effect-cloud spawn egg. Restore the concrete egg's registered entity rather than
+        // retaining a no-cooldown cloud spawner which can defeat per-cloud work limits by creating a swarm.
+        if (entityData != null && entityData.type() == net.minecraft.world.entity.EntityTypes.AREA_EFFECT_CLOUD && result.getItem() instanceof SpawnEggItem) {
+            TypedEntityData<net.minecraft.world.entity.EntityType<?>> defaultEntityData = result.getItem().components().get(DataComponents.ENTITY_DATA);
+            if (defaultEntityData != null && defaultEntityData.type() != net.minecraft.world.entity.EntityTypes.AREA_EFFECT_CLOUD) {
+                if (result == itemStack) {
+                    result = itemStack.copy();
+                }
+                result.set(DataComponents.ENTITY_DATA, defaultEntityData);
+                warnUnsafeCloudSpawnEggData(result, defaultEntityData.type());
+                return result;
+            }
+        }
+
+        if (entityData == null || entityData.type() != net.minecraft.world.entity.EntityTypes.AREA_EFFECT_CLOUD) {
+            return result;
+        }
+
+        net.minecraft.nbt.CompoundTag tag = entityData.copyTagWithoutId();
+        boolean changed = removeUnsafeAreaEffectCloudParticle(tag, "custom_particle");
+        // Some saved toolbars carry the older spelling alongside the current field. It is inert in this version,
+        // but remove the same payload rather than preserving a route for another loader or data conversion path.
+        changed |= removeUnsafeAreaEffectCloudParticle(tag, "Particle");
+        changed |= sanitizeAreaEffectCloudRadius(tag);
+        changed |= sanitizeAreaEffectCloudDuration(tag);
+        changed |= sanitizeAreaEffectCloudAge(tag);
+        changed |= sanitizeAreaEffectCloudWaitTime(tag);
+        if (!changed) {
+            return result;
+        }
+
+        if (result == itemStack) {
+            result = itemStack.copy();
+        }
+        result.set(DataComponents.ENTITY_DATA, TypedEntityData.of(entityData.type(), tag));
+        warnUnsafeCloudItemData(result);
+        return result;
+    }
