+    // Scissors start - eliminate unsafe item data before it reaches clients
+    /**
+     * Returns a copy of the stack whose nested-item components ({@code container}, {@code bundle_contents}, and
+     * {@code charged_projectiles}) omit any entry that fails contained-item validation. These are exactly the
+     * components {@link #validateComponents} recurses into, so covering all three closes the whole class of
+     * malformed-nested-item payloads rather than one instance of it.
+     *
+     * <p>The vanilla client turns an invalid bundle entry into an empty stack and then crashes in
+     * {@code BundleContents$Mutable#toImmutable} when the bundle is hovered; the other two components carry the same
+     * kind of payload and must never be sent to a client either. Surviving entries are also passed through
+     * {@link #sanitizeUnsafeData} recursively so valid-but-dangerous semantic data cannot hide in a nested carrier.
+     *
+     * <p>Returns the same instance when nothing needs to be removed, so this is cheap on the common path.
+     */
+    public static ItemStack sanitizeNestedItems(final ItemStack itemStack) {
+        ItemStack result = itemStack;
+
+        BundleContents bundle = result.get(DataComponents.BUNDLE_CONTENTS);
+        if (bundle != null) {
+            List<ItemStackTemplate> valid = filterValidNestedItems(bundle.items());
+            if (valid != null) {
+                result = result == itemStack ? itemStack.copy() : result;
+                result.set(DataComponents.BUNDLE_CONTENTS, new BundleContents(List.copyOf(valid)));
+            }
+        }
+
+        ChargedProjectiles charged = result.get(DataComponents.CHARGED_PROJECTILES);
+        if (charged != null) {
+            List<ItemStackTemplate> valid = filterValidNestedItems(charged.items());
+            if (valid != null) {
+                result = result == itemStack ? itemStack.copy() : result;
+                result.set(DataComponents.CHARGED_PROJECTILES, new ChargedProjectiles(List.copyOf(valid)));
+            }
+        }
+
+        ItemContainerContents container = result.get(DataComponents.CONTAINER);
+        if (container != null) {
+            ItemContainerContents cleaned = filterValidContainer(container);
+            if (cleaned != null) {
+                result = result == itemStack ? itemStack.copy() : result;
+                result.set(DataComponents.CONTAINER, cleaned);
+            }
+        }
+
+        return result;
+    }
